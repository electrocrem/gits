# Ghost in the Shell colour scheme for KDE / KF6 apps (Dolphin, Ark, Okular...): navy-black, cyan phosphor text, square contrast.
# Palette = docs/PALETTE.md. tools/post.py kdeglobals copies these sections into ~/.config/kdeglobals, as Plasma does.
[General]
ColorScheme=GitS
Name=Ghost in the Shell
shadeSortColumn=true

[KDE]
contrast=4

[ColorEffects:Disabled]
Color=6,10,20
ColorAmount=0
ColorEffect=0
ContrastAmount=0.55
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=false
Color=6,10,20
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

