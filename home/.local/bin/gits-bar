#!/usr/bin/env python3
"""gits-bar: the bar (waybar) with the modules you chose to hide left out (the desktop menu, Super+I -> Desktop).

  gits-bar run                start waybar (gits-bar.service runs this): writes the config and execs waybar
  gits-bar list               the bar's modules as JSON, in the bar's order: [{"id", "name", "side", "on", "fixed", "rank"}]
  gits-bar hide|show ID...    hide / show modules (ids from `list`; "workspaces" is all ten workspace buttons), then restart the bar
  gits-bar set [ID...] [--order SIDE=ID,ID...]...
                              hide exactly these (none = show all) and, with --order, put the modules of a side (left, center,
                              right) in this order; then restart the bar once
  gits-bar reset              show everything again, in the layout's order

Hidden modules live in ~/.config/gits/bar.conf (`hide = ID` lines), a changed order in `order = SIDE: ID ID...` lines (ids from
`list`; ones not named keep their place after the named ones). The written config ($XDG_RUNTIME_DIR/gits-bar.jsonc) includes the
GitS layout and repeats only its three module lists without the hidden ones: waybar keeps the including file's values over the
included one's, so the layout itself (and its recolouring by gits-theme) stays untouched."""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CONF = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
LAYOUT = os.path.join(CONF, "waybar", "layouts", "ghost-in-the-shell.jsonc")
STYLE = os.path.join(CONF, "waybar", "styles", "ghost-in-the-shell.css")
CHOICE = os.path.join(CONF, "gits", "bar.conf")
OUT = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "gits-bar.jsonc")
SIDES = ("modules-left", "modules-center", "modules-right")
NAMES = {"workspaces": "workspaces", "hyprland/window": "window title", "clock": "clock", "custom/gits-player": "now playing",
         "custom/gits-updates": "updates", "idle_inhibitor": "keep awake", "custom/gits-focus": "focus timer",
         "custom/gits-rec": "screen recording", "custom/gits-sys": "cpu / temperature", "custom/gits-gpu": "gpu",
         "memory": "memory", "disk": "disk", "network": "network", "bluetooth": "bluetooth", "pulseaudio": "volume",
         "custom/gits-lang": "keyboard layout", "custom/gits-mode": "workflow", "custom/gits-notify": "notifications",
         "battery": "battery", "tray": "tray", "custom/gits-power": "power menu"}
KEEP = {"custom/gits-power"}   # the way out of the session stays on the bar


def module_id(m):
    """custom/gits-ws3 -> workspaces, memory#gits -> memory."""
    return "workspaces" if re.fullmatch(r"custom/gits-ws\d+", m) else m.split("#")[0]


def layout_lists():
    with open(LAYOUT) as f:
        text = f.read()
    out = {}
    for side in SIDES:
        m = re.search(r'"%s"\s*:\s*\[(.*?)\]' % side, text, re.S)
        out[side] = re.findall(r'"([^"]+)"', re.sub(r"//[^\n]*", "", m.group(1))) if m else []
    return out


def read_choice():
    """(hidden ids, {side: [ids in the chosen order]}) from bar.conf."""
    off, order = set(), {}
    try:
        with open(CHOICE) as f:
            for line in f:
                key, eq, val = line.partition("=")
                key, val = key.strip(), val.strip()
                if not eq or key.startswith("#"):
                    continue
                if key == "hide" and val:
                    off.add(val)
                elif key == "order" and ":" in val:
                    side, ids = val.split(":", 1)
                    order[side.strip()] = ids.split()
    except OSError:
        pass
    return off - KEEP, order


def hidden():
    return read_choice()[0]


def save(ids, order=None):
    """Write bar.conf: the hidden ids and, if given (else the one already there is kept), the order per side."""
    order = read_choice()[1] if order is None else order
    os.makedirs(os.path.dirname(CHOICE), exist_ok=True)
    with open(CHOICE, "w") as f:
        f.write("# the bar (gits-bar / the desktop menu): hidden modules and the order per side; `gits-bar reset` undoes both\n")
        f.writelines(f"hide = {i}\n" for i in sorted(ids))
        f.writelines(f"order = {side}: {' '.join(ids)}\n" for side, ids in order.items() if ids)


def ordered(side, mods, order):
    """The layout's modules of one side, sorted by the chosen order (by id; the ten workspace buttons move as one block).
    Ids not in the order keep their layout order after the named ones."""
    want = order.get(side.split("-")[1], [])
    rank = {i: n for n, i in enumerate(want)}
    return sorted(mods, key=lambda m: rank.get(module_id(m), len(rank)))


def write_config():
    off, order = read_choice()
    cfg = {"include": [LAYOUT]}
    for side, mods in layout_lists().items():
        cfg[side] = [m for m in ordered(side, mods, order) if module_id(m) not in off]
    with open(OUT, "w") as f:
        json.dump(cfg, f, indent=1)


def restart():
    if subprocess.run(["systemctl", "--user", "is-active", "--quiet", "gits-bar.service"]).returncode == 0:
        subprocess.run(["systemctl", "--user", "restart", "gits-bar.service"])   # last: a popup opened from the bar dies with it
    else:
        write_config()
        subprocess.run(["pkill", "-USR2", "-x", "waybar"])


def main(argv):
    cmd = argv[0] if argv else "run"
    if cmd == "run":
        write_config()
        os.execvp("waybar", ["waybar", "-c", OUT, "-s", STYLE])
    if cmd == "list":
        (off, order), seen, rows = read_choice(), set(), []
        for side, mods in layout_lists().items():
            home = [module_id(m) for m in mods]
            for m in ordered(side, mods, order):
                i = module_id(m)
                if i in seen:
                    continue
                seen.add(i)
                rows.append({"id": i, "name": NAMES.get(i, i.split("/")[-1].replace("gits-", "")), "side": side.split("-")[1],
                             "on": i not in off, "fixed": i in KEEP, "rank": home.index(i)})   # rank: place in the layout
        print(json.dumps(rows))
        return 0
    if cmd in ("hide", "show") and len(argv) > 1:
        off = hidden()
        off = (off | set(argv[1:])) if cmd == "hide" else (off - set(argv[1:]))
        save(off - KEEP)
        restart()
        return 0
    if cmd == "set":
        ids, order, args = set(), {}, list(argv[1:])
        while args:
            a = args.pop(0)
            if a == "--order" and args:
                side, _, mods = args.pop(0).partition("=")
                if side in ("left", "center", "right"):
                    order[side] = [m for m in mods.split(",") if m]
            else:
                ids.add(a)
        old_off, old_order = read_choice()
        new_order = {**old_order, **order}
        if ids - KEEP != old_off or {k: v for k, v in new_order.items() if v} != {k: v for k, v in old_order.items() if v}:
            save(ids - KEEP, new_order)
            restart()
        return 0
    if cmd == "reset":
        save(set(), {})
        restart()
        return 0
    print(__doc__.split("\n\n")[0], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
