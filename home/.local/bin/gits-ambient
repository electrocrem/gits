#!/usr/bin/env python3
"""gits-ambient: sound bars on the desktop (ambient.py, gits-ambient.service; Super+I -> Desktop sound bars).

  gits-ambient status | on | off | toggle
"""
import json
import os
import signal
import sys

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), "gits", "ambient.json")
PID = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "gits-ambient.pid")


def load():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {}


def main(argv):
    cmd = argv[0] if argv else "status"
    c = load()
    on = c.get("spectrum", True)
    if cmd == "status":
        print("on" if on else "off")
        return 0
    if cmd not in ("on", "off", "toggle"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    c = {"spectrum": (cmd == "on") if cmd != "toggle" else not on}
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    json.dump(c, open(CONF, "w"))
    try:   # tell the running bars (SIGHUP = read the setting again)
        pid = int(open(PID).read())
        if "ambient.py" in open(f"/proc/{pid}/cmdline").read():
            os.kill(pid, signal.SIGHUP)
    except (OSError, ValueError):
        pass
    print("on" if c["spectrum"] else "off")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
