#!/usr/bin/env bash
# gits-rog: the M4 / ROG key (KEY_PROG1 = XF86Launch1) opens ROG Control Center, like Armoury Crate on Windows; pressed again it
# closes the window (the tray instance keeps running). Ignores the key's rapid repeats (0.7 s).
class=org.opengamingcollective.rog-control-center
stamp=${XDG_RUNTIME_DIR:-/tmp}/gits-rog.stamp
now=$(date +%s%N); last=$(cat "$stamp" 2>/dev/null || echo 0)
(( now - last < 700000000 )) && exit 0
echo "$now" >"$stamp"
addr=$(hyprctl clients -j | jq -r --arg c "$class" '[.[] | select(.class == $c)][0].address // empty')
if [[ -n $addr ]]; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
else
    command -v rog-control-center >/dev/null || { notify-send -a "GitS" "ROG Control Center is not installed"; exit 1; }
    setsid -f rog-control-center </dev/null >/dev/null 2>&1   # a running tray instance just shows its window
fi
