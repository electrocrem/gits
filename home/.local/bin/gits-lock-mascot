#!/usr/bin/env bash
# hyprlock label: the braille frame of the lock-screen mascot for this instant, 8 frames a second.
#   GITS_LOCK_MASCOT=tachikoma (default: the turning Tachikoma hologram) | lain (the dancing Lain) | off
# Frames are ~/.local/share/gits-lock/<mascot>-N.txt (tachikoma.py, build.py). No forks besides the subshell: it runs 8 times a second.
d=${XDG_DATA_HOME:-$HOME/.local/share}/gits-lock
m=${GITS_LOCK_MASCOT:-tachikoma}
f=("$d/$m"-*.txt)
[[ $m != off && -e ${f[0]} ]] || exit 0
n=$(( (${EPOCHREALTIME/./} / 125000) % ${#f[@]} ))
echo "$(<"$d/$m-$n.txt")"
