#!/usr/bin/env python3
"""gits-drives: USB sticks, SD cards and external disks (Super+I -> Drives).

  gits-drives run           the service (gits-drives.service): a plugged-in drive is mounted (unless automount is off) and a
                            notification offers Open / Eject; pulling one out while mounted gets a warning
  gits-drives list          removable filesystems: device <tab> name <tab> size <tab> mount point ("" = not mounted)
  gits-drives eject DEV     safe removal: flush the writes, unmount (a busy drive says which programs hold it), power it off
  gits-drives mount DEV     gits-drives open DEV (mounts first)
  gits-drives menu          every drive: open / eject / mount;  automount on / off
  gits-drives automount [on|off]
Uses UDisks2 like the file manager (no root: polkit allows the active session). Encrypted drives are left to the file manager.
"""
import json
import os
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")), "gits", "drives-noauto")
UD = "org.freedesktop.UDisks2"
LOOP = os.environ.get("GITS_DRIVES_LOOP") == "1"   # tests: treat loop devices as drives


def bus():
    return Gio.bus_get_sync(Gio.BusType.SYSTEM)


def managed():
    r = bus().call_sync(UD, "/org/freedesktop/UDisks2", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
                        None, GLib.VariantType("(a{oa{sa{sv}}})"), Gio.DBusCallFlags.NONE, 5000, None)
    return r.unpack()[0]


def bstr(v):
    """UDisks byte strings (NUL-terminated ay) -> str."""
    return bytes(v).rstrip(b"\0").decode(errors="replace") if v else ""


def human(n):
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or u == "TB":
            return f"{n:.0f} {u}" if u in ("B", "KB", "MB") else f"{n:.1f} {u}"
        n /= 1000


def drives(objs=None):
    """Removable filesystems: [{path, dev, name, size, mount, drive, crypto}]."""
    objs = objs if objs is not None else managed()
    out = []
    for path, ifs in objs.items():
        blk = ifs.get("org.freedesktop.UDisks2.Block")
        if not blk or blk.get("HintIgnore") or blk.get("IdUsage") not in ("filesystem", "crypto"):
            continue
        drv = objs.get(blk.get("Drive", "/"), {}).get("org.freedesktop.UDisks2.Drive", {})
        removable = drv and (drv.get("Removable") or drv.get("MediaRemovable") or drv.get("ConnectionBus") in ("usb", "sdio"))
        loop = LOOP and "org.freedesktop.UDisks2.Loop" in objs.get(path, {}) or (LOOP and bstr(blk.get("Device")).startswith("/dev/loop"))
        if not (removable or loop) or (blk.get("HintSystem") and not loop and not removable):
            continue
        fs = ifs.get("org.freedesktop.UDisks2.Filesystem")
        mounts = [bstr(m) for m in (fs or {}).get("MountPoints", [])]
        name = blk.get("IdLabel") or " ".join(x for x in (drv.get("Vendor", "").strip(), drv.get("Model", "").strip()) if x) or "drive"
        out.append({"path": path, "dev": bstr(blk.get("PreferredDevice") or blk.get("Device")), "name": name,
                    "size": blk.get("Size", 0), "mount": mounts[0] if mounts else "", "drive": blk.get("Drive", "/"),
                    "crypto": blk.get("IdUsage") == "crypto", "fs": bool(fs)})
    return sorted(out, key=lambda d: d["dev"])


def find(dev):
    real = os.path.realpath(dev) if dev.startswith("/") else "/dev/" + dev
    return next((d for d in drives() if os.path.realpath(d["dev"]) == real or d["dev"] == dev), None)


def notify(title, body="", icon="drive-removable-media", wait_actions=None, cat=None):
    cmd = ["notify-send", "-a", "GitS Notify", "-i", icon]
    if cat:
        cmd += ["-c", f"gits.{cat}"]
    for k, v in (wait_actions or {}).items():
        cmd += ["-A", f"{k}={v}"]
    if wait_actions:
        cmd.append("--wait")
    cmd += [title, body]
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def call_fs(path, method, opts=None):
    args = GLib.Variant("(a{sv})", (opts or {},))
    return bus().call_sync(UD, path, "org.freedesktop.UDisks2.Filesystem", method, args, None, Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION,
                           60000, None)


def mount(d):
    if d["mount"]:
        return d["mount"]
    if d["crypto"] or not d["fs"]:
        return ""
    r = call_fs(d["path"], "Mount")
    return r.unpack()[0]


def holders(mnt):
    """Programs with files open on the drive (their names), via /proc."""
    names = set()
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            fds = os.listdir(f"/proc/{p}/fd")
            cwd = os.readlink(f"/proc/{p}/cwd")
        except OSError:
            continue
        hit = cwd == mnt or cwd.startswith(mnt + "/")
        for fd in fds if not hit else []:
            try:
                t = os.readlink(f"/proc/{p}/fd/{fd}")
            except OSError:
                continue
            if t == mnt or t.startswith(mnt + "/"):
                hit = True
                break
        if hit:
            try:
                names.add(open(f"/proc/{p}/comm").read().strip())
            except OSError:
                pass
    return sorted(names)


def eject(dev):
    d = find(dev)
    if not d:
        notify("󰕓  No such drive", dev, "dialog-warning")
        return 1
    if d["mount"]:
        subprocess.run(["sync", "-f", d["mount"]], capture_output=True, timeout=300)
        try:
            call_fs(d["path"], "Unmount")
        except GLib.Error as e:
            who = holders(d["mount"])
            notify(f"󰕓  {d['name']} is busy", ("still open in: " + ", ".join(who)) if who else e.message.split(":")[-1].strip(),
                   "dialog-warning", cat="error")
            return 1
    for other in drives():   # other partitions of the same stick
        if other["drive"] == d["drive"] and other["mount"]:
            try:
                subprocess.run(["sync", "-f", other["mount"]], capture_output=True, timeout=300)
                call_fs(other["path"], "Unmount")
            except GLib.Error:
                notify(f"󰕓  {other['name']} is busy", ", ".join(holders(other["mount"])), "dialog-warning", cat="error")
                return 1
    if d["drive"] != "/":
        try:
            bus().call_sync(UD, d["drive"], "org.freedesktop.UDisks2.Drive", "PowerOff", GLib.Variant("(a{sv})", ({},)), None,
                            Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 30000, None)
        except GLib.Error:
            pass   # some card readers cannot power off: unmounted is enough
    notify(f"󰕓  {d['name']}: safe to remove", human(d["size"]), "media-eject", cat="unplug")
    return 0


def open_dev(dev):
    d = find(dev)
    if not d:
        return 1
    try:
        m = mount(d)
    except GLib.Error as e:
        notify(f"󰕓  {d['name']}: not mounted", e.message.split(":")[-1].strip(), "dialog-warning")
        return 1
    if m:
        subprocess.Popen(["xdg-open", m], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def automount():
    return not os.path.exists(STATE)


def offer(d):
    """The notification of a new drive: Open / Eject (in a thread: --wait blocks until it is clicked or closed)."""
    where = d["mount"].replace(HOME, "~") if d["mount"] else "not mounted (automount is off)"
    a = notify(f"󰕓  {d['name']}  ·  {human(d['size'])}", where, wait_actions={"open": "Open", "eject": "Eject"}, cat="plug")
    if a == "open":
        open_dev(d["dev"])
    elif a == "eject":
        eject(d["dev"])


def run():
    seen = {d["path"]: d for d in drives()}   # already there at start: no notifications
    loop = GLib.MainLoop()

    def changed(*_):
        GLib.timeout_add(700, rescan)   # let udisks finish probing the new device (label, filesystem)

    def rescan():
        nonlocal seen
        try:
            now = {d["path"]: d for d in drives()}
        except GLib.Error:
            return False
        for p, d in now.items():
            if p in seen:
                continue
            if d["crypto"]:
                notify(f"󰕓  {d['name']}: encrypted", "open it in the file manager to unlock it", "drive-removable-media", cat="plug")
                continue
            if automount() and d["fs"] and not d["mount"]:
                try:
                    d["mount"] = mount(d)
                except GLib.Error as e:
                    notify(f"󰕓  {d['name']}: could not mount", e.message.split(":")[-1].strip(), "dialog-warning", cat="error")
                    continue
            threading.Thread(target=offer, args=(d,), daemon=True).start()
        for p, d in seen.items():
            if p not in now and d["mount"]:
                notify(f"󰕓  {d['name']} was pulled out without Eject", "files still being written may be lost: eject first "
                       "(Super+I -> Drives, or the notification)", "dialog-warning", cat="error")
        seen = now
        return False

    def track(*_):   # mount / unmount from anywhere (file manager, udiskie): keep the "was mounted" view current
        GLib.timeout_add(300, lambda: (seen.update({p: d for p, d in ((d["path"], d) for d in drives()) if p in seen}), False)[1])

    b = bus()
    b.signal_subscribe(UD, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded", "/org/freedesktop/UDisks2", None,
                       Gio.DBusSignalFlags.NONE, changed)
    b.signal_subscribe(UD, "org.freedesktop.DBus.ObjectManager", "InterfacesRemoved", "/org/freedesktop/UDisks2", None,
                       Gio.DBusSignalFlags.NONE, changed)
    b.signal_subscribe(UD, "org.freedesktop.DBus.Properties", "PropertiesChanged", None, "org.freedesktop.UDisks2.Filesystem",
                       Gio.DBusSignalFlags.NONE, track)
    loop.run()


def menu():
    ds = drives()
    rows, acts = [], []
    for d in ds:
        state = d["mount"].replace(HOME, "~") if d["mount"] else ("encrypted" if d["crypto"] else "not mounted")
        rows.append(f"󰕓  {d['name']}  ·  {human(d['size'])}  ·  {state}")
        acts.append(("drive", d))
    rows.append("󰁪  Automount: " + ("ON (switch off)" if automount() else "OFF (switch on)"))
    acts.append(("auto", None))
    r = subprocess.run(["gits-menu", f"󰕓  DRIVES: {len(ds)}", "// 媒体", "-format", "i"], input="\n".join(rows),
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip().isdigit():
        return 0
    kind, d = acts[int(r.stdout.strip())]
    if kind == "auto":
        return set_auto(not automount())
    opts = ["󰉋  Open", "󰕔  Eject (safe to remove)"] if d["mount"] else ["󰉋  Mount and open", "󰕔  Power off (safe to remove)"]
    c = subprocess.run(["gits-menu", f"󰕓  {d['name'].upper()}", "// 媒体", "-format", "i"], input="\n".join(opts),
                       capture_output=True, text=True).stdout.strip()
    if c == "0":
        return open_dev(d["dev"])
    if c == "1":
        return eject(d["dev"])
    return 0


def set_auto(on):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    if on and os.path.exists(STATE):
        os.remove(STATE)
    elif not on:
        open(STATE, "w").close()
    print("automount", "on" if on else "off")
    return 0


def main(argv):
    cmd = argv[0] if argv else "menu"
    if cmd == "run":
        run()
        return 0
    if cmd == "list":
        for d in drives():
            print(f"{d['dev']}\t{d['name']}\t{human(d['size'])}\t{d['mount']}")
        return 0
    if cmd == "json":
        print(json.dumps(drives()))
        return 0
    if cmd == "status":
        ds = drives()
        print(f"{len(ds)} connected" if ds else ("none · automount " + ("on" if automount() else "off")))
        return 0
    if cmd in ("eject", "mount", "open") and len(argv) > 1:
        return eject(argv[1]) if cmd == "eject" else open_dev(argv[1])
    if cmd == "automount":
        if len(argv) > 1 and argv[1] in ("on", "off"):
            return set_auto(argv[1] == "on")
        print("on" if automount() else "off")
        return 0
    if cmd == "menu":
        return menu()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
