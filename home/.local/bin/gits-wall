#!/usr/bin/env bash
# gits-wall [FILE | --pick | --list | --default]: the wallpaper, on every output, with awww (PNG, JPEG, WebP and animated GIF).
#   gits-wall FILE      show FILE and remember it (the choice is applied again at every login)
#   gits-wall --pick    choose from a menu (the wallpaper folders below), fade to the new one
#   gits-wall --list    print the pictures the menu would offer
#   gits-wall --default forget the choice and go back to gits_smoke.png
#   gits-wall --theme NAME FILE   remember FILE for the colour theme NAME (the appearance menu); shown now if NAME is the current theme
#   gits-wall --fit FILE...       make pictures fit the screen (gits-wallfit: cut to fill, or whole on a blurred backdrop; originals kept)
#   gits-wall           apply the remembered wallpaper (this is what gits-wallpaper.service runs at login)
# Folders searched: ~/.local/share/gits/wallpapers and ~/Pictures/wallpapers (add more with GITS_WALL_DIRS="dir:dir").
# An animated GIF is drawn all the time: measured in awww-daemon, a 24-frame loop costs about 2% of one core and ~20 MB, a 68-frame 1280x800 loop
# about 5% and ~100 MB. Fewer frames and a smaller size make it cheaper.
# The lock screen and the login screen have their own pictures.
default=$HOME/.local/share/gits/wallpapers/gits_smoke.png
state=${XDG_STATE_HOME:-$HOME/.local/state}/gits/wallpaper
# the colour theme (gits-theme) remembers its own wallpaper too: wallpaper.<theme>, shown again when you switch back to that theme
theme=$(sed -n 's/^theme=//p' "${XDG_STATE_HOME:-$HOME/.local/state}/gits/state" 2>/dev/null | head -1); theme=${theme:-gits}
remember() { mkdir -p "$(dirname "$state")"; printf '%s\n' "$1" >"$state"; printf '%s\n' "$1" >"$state.$theme"; }
IFS=: read -ra dirs <<<"$HOME/.local/share/gits/wallpapers:$HOME/Pictures/wallpapers:${GITS_WALL_DIRS:-}"

list() { for d in "${dirs[@]}"; do [[ -d $d ]] && find "$d" -maxdepth 2 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) -print; done | sort -u; }

apply() {  # apply FILE [transition]
    [[ -r $1 ]] || { echo "no wallpaper at $1" >&2; return 1; }
    for _ in {1..40}; do awww query >/dev/null 2>&1 && break; sleep 0.25; done
    awww img "$1" --transition-type "${2:-none}"
}

case ${1:-} in
    --list) list ;;
    --fit) shift; exec gits-wallfit "$@" ;;
    --theme)
        [[ -n ${2:-} && -r ${3:-} ]] || { echo "usage: gits-wall --theme NAME FILE" >&2; exit 2; }
        f=$(realpath -- "$3"); mkdir -p "$(dirname "$state")"
        if [[ $2 == "$theme" ]]; then apply "$f" fade && remember "$f"; else printf '%s\n' "$f" >"$state.$2"; fi ;;
    --default) rm -f "$state" "$state.$theme"; apply "$default" fade ;;
    --pick)
        mapfile -t files < <(list)
        ((${#files[@]})) || { echo "no pictures found in: ${dirs[*]}" >&2; exit 1; }
        rows=(); for f in "${files[@]}"; do rows+=("$(basename "$f")   ${f%/*}"); done
        idx=$(printf '%s\n' "${rows[@]}" | gits-menu "󰸉  WALLPAPER" "// 壁紙" -format i) || exit 0
        f=${files[idx]}
        apply "$f" fade && remember "$f" ;;
    "")
        f=$default; [[ -r $state ]] && read -r saved <"$state" && [[ -r $saved ]] && f=$saved
        apply "$f" ;;
    *)
        f=$(realpath -- "$1" 2>/dev/null) || f=$1
        apply "$f" fade && remember "$f" ;;
esac
