#!/usr/bin/env bash
# gits-phone: send things to your phone over KDE Connect (Super+Ctrl+M, Super+I -> Send to phone).
#   gits-phone menu      pick one (the default)
#   gits-phone text      the clipboard's text (a link opens on the phone)
#   gits-phone shot      the newest screenshot (~/Pictures/Screenshots)
#   gits-phone file      pick a file
#   gits-phone ring      make the phone ring, to find it
#   gits-phone status    "Pixel 10 Pro · 81%" or "no phone"
# The phone is the first paired KDE Connect device that is reachable now (GITS_PHONE=<device id> picks one).
say() { notify-send -a "GitS Notify" ${snd:+-c "gits.$snd"} -i smartphone "󰄜  ${1}" "${2:-}"; }   # snd=send: with the swoosh
dev=${GITS_PHONE:-$(kdeconnect-cli -a --id-only 2>/dev/null | head -1)}
name() { kdeconnect-cli -a --id-name-only 2>/dev/null | awk -v d="$dev" '$1 == d { $1 = ""; sub(/^ /, ""); print; exit }'; }
battery() {
    gdbus call --session --dest org.kde.kdeconnect --object-path "/modules/kdeconnect/devices/$dev/battery" \
        --method org.freedesktop.DBus.Properties.Get org.kde.kdeconnect.device.battery charge 2>/dev/null | grep -oE '[0-9]+' | head -1
}
need() { [[ -n $dev ]] || { say "No phone" "KDE Connect sees no paired phone on this network"; exit 1; }; }
shot_dir=${GITS_SHOT_DIR:-$HOME/Pictures/Screenshots}

case ${1:-menu} in
    status)
        [[ -n $dev ]] || { echo "no phone"; exit 0; }
        b=$(battery); echo "$(name)${b:+ · $b%}" ;;
    text)
        need
        t=$(wl-paste -n -t text 2>/dev/null)
        [[ -n ${t//[[:space:]]/} ]] || { say "Nothing to send" "the clipboard holds no text"; exit 1; }
        if [[ $t =~ ^https?://[^[:space:]]+$ ]]; then kdeconnect-cli -d "$dev" --share "$t" >/dev/null && snd=send say "Link sent to $(name)" "$t"
        else kdeconnect-cli -d "$dev" --share-text "$t" >/dev/null && snd=send say "Text sent to $(name)" "$(head -c 100 <<<"$t")"; fi ;;
    shot)
        need
        f=$(ls -t "$shot_dir"/*.png 2>/dev/null | head -1)
        [[ -n $f ]] || { say "No screenshot" "nothing in ${shot_dir/#$HOME/~}"; exit 1; }
        kdeconnect-cli -d "$dev" --share "$f" >/dev/null && snd=send say "Screenshot sent to $(name)" "${f##*/}" ;;
    file)
        need
        f=$(zenity --file-selection --title="Send to $(name)" --filename="$HOME/" 2>/dev/null) || exit 0
        kdeconnect-cli -d "$dev" --share "$f" >/dev/null && snd=send say "Sent to $(name)" "${f##*/}" ;;
    ring)
        need
        kdeconnect-cli -d "$dev" --ring >/dev/null && say "Ringing $(name)" ;;
    menu)
        if [[ -z $dev ]]; then say "No phone" "KDE Connect sees no paired phone on this network"; exit 1; fi
        b=$(battery)
        rows=$'󰅍  Clipboard text / link\n󰹑  Newest screenshot\n󰈔  A file…\n󰂞  Ring the phone (find it)'
        i=$(gits-menu "󰄜  $(name | tr '[:lower:]' '[:upper:]')${b:+  ·  $b%}" "// 送信" -format i <<<"$rows") || exit 0
        case $i in 0) exec "$0" text ;; 1) exec "$0" shot ;; 2) exec "$0" file ;; 3) exec "$0" ring ;; esac ;;
    *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
