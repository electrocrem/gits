#!/usr/bin/env bash
# gits-exit: end the Hyprland session (wlogout, the control panel and Super+Delete call this).
# Asks Hyprland to exit; if the session is still alive after 3 s (Hyprland hung, or start-hyprland restarted it after an unclean exit),
# logind ends the session, and SDDM shows the greeter again. Every step is logged to ~/.local/state/gits/exit.log.
log=${XDG_STATE_HOME:-$HOME/.local/state}/gits/exit.log
mkdir -p "$(dirname "$log")"
say() { printf '%s %s\n' "$(date +%T)" "$*" >>"$log"; }
say "start: sig=${HYPRLAND_INSTANCE_SIGNATURE:-none} session=${XDG_SESSION_ID:-none} parent=$(ps -o comm= -p $PPID)"
out=$(hyprctl dispatch 'hl.dsp.exit()' 2>&1); say "dispatch exit: rc=$? '$out'"
alive() { hyprctl version >/dev/null 2>&1 || pgrep -u "$UID" -x start-hyprland >/dev/null; }
for _ in 1 2 3 4 5 6; do sleep 0.5; alive || { say "session gone"; exit 0; }; done
sid=${XDG_SESSION_ID:-$(loginctl show-user "$USER" -p Display --value 2>/dev/null)}
say "still alive after 3 s: terminate-session '$sid'"
[[ -n $sid ]] || { say "no session id"; notify-send -a GitS -u critical "Logout" "Hyprland did not exit and the session id is unknown" 2>/dev/null; exit 1; }
out=$(loginctl terminate-session "$sid" 2>&1); say "terminate-session: rc=$? '$out'"
