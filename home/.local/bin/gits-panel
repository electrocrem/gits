#!/usr/bin/env bash
# gits-panel [control|media|radio|notify|mixer|note|launch|clip|windows|emoji|keys|appearance|themes|desktop|settings|overview|clean|games|close]: the popups under the bar. Running the same one again closes it; the other one replaces it.
#   control  toggles, sliders, power profile, charge limit   (Super+Shift+C, waybar power-profile module)
#   media    player: cover, seek, transport, volume          (Super+Shift+M, click on the player module)
#   radio    web radio: cover, live spectrum, listeners, tune in/out (Super+R; the radio itself is `gits-radio`)
#   mixer    sound mixer: master + output devices + one slider per playing app (Super+Alt+V, click on the bar's volume icon)
#   note     quick note into ~/notes/inbox.md (Super+N; see also gits-note)
#   launch   command palette: apps, settings, projects, windows, notes, calculator, web search (Super+A)
#   clip     clipboard history (Super+V)
#   windows  window switcher, most recent first (Super+Tab)
#   overview every workspace as a thumbnail with its windows; click goes there, drag an icon moves the window (Super+grave)
#   clean    free disk space: package / AUR / uv caches, trash, old logs... with sizes, tick and clean (Super+I -> Free disk space)
#   games    game library: installed Steam games as covers, hours played, Enter plays (Super+Shift+G)
#   emoji    emoji and symbol picker by name, Enter copies (Super+comma)
#   keys     every key binding with its description (Super+slash)
#   desktop     which desktop widgets and which bar modules are shown (Super+I -> Desktop; gits-bar, ~/.config/gits/widgets.conf)
#   appearance  colour theme, your accent on top of it, lock-screen mascot, wallpaper (gits-theme select, Super+I -> Appearance; `themes` = the same)
#   settings    the settings hub: every setting in sections with its current value, system facts (Super+I, gits-settings)
#   notify   notification centre: history, delete, clear, do-not-disturb (Super+Shift+N, click on the bell)
pidfile=${XDG_RUNTIME_DIR:-/tmp}/gits-panel.pid
mode=${1:-control}
[[ -r $pidfile ]] && read -r pid cur <"$pidfile"
alive=0; [[ $pid =~ ^[0-9]+$ ]] && grep -qa 'panel.py' "/proc/$pid/cmdline" 2>/dev/null && alive=1
((alive)) && kill "$pid" 2>/dev/null
# wait for the old popup to be gone: a re-open right after a close must not see it as "still running" and toggle itself off
if ((alive)); then for _ in {1..30}; do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done; rm -f "$pidfile"; fi
case $mode in
    close) exit 0 ;;
    control|media|radio|notify|mixer|note|launch|clip|windows|emoji|keys|appearance|themes|desktop|settings|activity|brief|overview|clean|games) ((alive)) && [[ $cur == "$mode" ]] && exit 0 ;;   # pressed again = close
    *) echo "usage: gits-panel [control|media|radio|notify|mixer|note|launch|clip|windows|emoji|keys|appearance|themes|desktop|settings|overview|clean|games|close]" >&2; exit 2 ;;
esac
log=${XDG_RUNTIME_DIR:-/tmp}/gits-panel.log
# the warm spare of gits-panel.service (popupd.py) shows it at once; without it panel.py starts cold (~0.2 s more). socat, not the
# Python client: that would cost another ~50 ms. socat gives up 1 s after sending; the spare then shows nothing, so no double popup.
sock=${XDG_RUNTIME_DIR:-/tmp}/gits-panel.sock reply=""
if [[ -S $sock ]] && command -v socat >/dev/null; then
    IFS= read -r -t 2 reply < <(printf '{"argv": ["%s"], "log": "%s"}\n' "$mode" "$log" | socat -t 1 - "UNIX-CONNECT:$sock" 2>/dev/null)
    [[ $reply =~ ^pid\ ([0-9]+)$ ]] && { echo "${BASH_REMATCH[1]} $mode" >"$pidfile"; exit 0; }
fi
# preloading gtk4-layer-shell here saves panel.py from re-executing itself to get it (a second Python start, ~0.15 s)
ls_lib=/usr/lib/libgtk4-layer-shell.so; [[ -e $ls_lib ]] && export LD_PRELOAD="$ls_lib${LD_PRELOAD:+ $LD_PRELOAD}"
python3 "$HOME/.config/gits-widgets/panel.py" "$mode" >"$log" 2>&1 &
echo "$! $mode" >"$pidfile"
