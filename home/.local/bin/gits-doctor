#!/usr/bin/env bash
# gits-doctor: one-shot health report for the Ghost in the Shell desktop customisations.
# Read-only: it never restarts anything. Exit code = number of FAILs.
#   gits-doctor          full report
#   gits-doctor -q       only WARN/FAIL lines
#   gits-doctor -l       also show the tail of the login breadcrumb log and the SDDM journal
#   gits-doctor --fix    after the report, repair what KDE apps / crashes typically undo (see the end of this
#                        file): GTK4 hang, kded6 gtkconfig, cursor sync, dead helpers, failed units.
#                        Never touches the workflow (you may be gaming), login hooks, or anything needing sudo.
set -u

QUIET=0; LOGS=0; FIX=0
for a in "$@"; do case $a in -q) QUIET=1 ;; -l) LOGS=1 ;; -f|--fix) FIX=1 ;; esac; done

if [[ -t 1 ]]; then
    C_OK=$'\e[38;2;46;211;215m'; C_WARN=$'\e[38;2;240;200;80m'; C_BAD=$'\e[38;2;240;80;80m'
    C_DIM=$'\e[2m'; C_B=$'\e[1m'; C_0=$'\e[0m'
else
    C_OK= C_WARN= C_BAD= C_DIM= C_B= C_0=
fi
FAILS=0 WARNS=0 OKS=0

ok()   { OKS=$((OKS + 1));     [[ $QUIET == 1 ]] || printf '  %s[ ok ]%s %s\n' "$C_OK" "$C_0" "$1"; }
warn() { WARNS=$((WARNS + 1)); printf '  %s[warn]%s %s\n' "$C_WARN" "$C_0" "$1"; }
bad()  { FAILS=$((FAILS + 1)); printf '  %s[FAIL]%s %s\n' "$C_BAD" "$C_0" "$1"; }
head_() { [[ $QUIET == 1 ]] || printf '\n%s// %s%s\n' "$C_B" "$1" "$C_0"; }

H=$HOME
RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# ---------------------------------------------------------------- session
head_ "session"
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && ! hyprctl version >/dev/null 2>&1; then
    bad "Hyprland is not reachable from this shell (run gits-doctor inside the session)"
else
    mons=$(hyprctl monitors -j 2>/dev/null | jq 'length' 2>/dev/null || echo 0)
    if [[ ${mons:-0} -ge 1 ]]; then
        desc=$(hyprctl monitors -j | jq -r '.[] | "\(.name) \(.width)x\(.height)@\(.refreshRate|floor)"' | paste -sd, -)
        ok "monitors: $desc"
    else
        bad "Hyprland has 0 monitors (blind session: the AMD/NVIDIA login race)"
    fi

    errs=$(hyprctl configerrors 2>/dev/null | sed '/^$/d')
    if [[ -z $errs ]]; then ok "no Hyprland config errors"; else bad "config errors: $(head -c 200 <<<"$errs")"; fi

    # instance dirs of dead compositors stay in $RUN/hypr until reboot; the blind-session guard names the
    # instance it ended in the login log, so a dead dir it accounts for is a recovered race, not a problem
    dead=() lastguard=
    for d in "$RUN"/hypr/*/; do
        [[ -d $d ]] || continue
        pid=$(head -1 "$d/hyprland.lock" 2>/dev/null)
        [[ -n $pid && -d /proc/$pid ]] && continue
        dead+=("${d%/}")
    done
    if [[ ${#dead[@]} -eq 0 ]]; then ok "single Hyprland instance dir"; else
        unexplained=0
        for d in "${dead[@]}"; do
            g=$(grep -F "blind-guard: no monitor on ${d##*/} " "$H/.local/state/gits-login.log" 2>/dev/null | tail -1)
            if [[ -n $g ]]; then lastguard=${g%% *}; else unexplained=$((unexplained+1)); fi
        done
        if [[ $unexplained -gt 0 ]]; then
            warn "$unexplained dead Hyprland instance dir(s) in $RUN/hypr that the blind-session guard did not end (the compositor crashed or was restarted)"
        else
            ok "login race hit at $lastguard and was recovered by the blind-session guard (dead instance log stays until reboot)"
        fi
    fi
fi

# ---------------------------------------------------------------- desktop state
head_ "desktop state"
st=$H/.local/state/gits/state
getst() { grep -m1 "^$1=" "$st" 2>/dev/null | cut -d= -f2-; }
[[ -f $H/.config/hypr/hyprland.lua ]] && grep -q 'gits' "$H/.config/hypr/hyprland.lua" && ok "hyprland.lua is the GitS config" || bad "~/.config/hypr/hyprland.lua is not the GitS config (./install.sh)"
ce=$H/.local/state/gits/config-errors.log
if [[ -s $ce ]]; then bad "a config module failed to load, see $ce: $(head -c 160 "$ce" | tr '\n' ' ')"; else ok "all config modules loaded"; fi
wf=$(getst workflow)
if [[ -z $wf || $wf == 01-default ]]; then ok "workflow: default"
else warn "workflow is '$wf': it overrides parts of the GitS look (gaps/blur/animations). Back: gits-workflow set 01-default"; fi
an=$(getst animation); [[ -z $an ]] && an=cyber; case $an in cyber | gits | lively) ok "animation preset: $an" ;; *) warn "animation preset is '$an' (gits-anim set cyber for the GitS look)" ;; esac
cur=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")
[[ $cur == GitS-Cursors ]] && ok "cursor theme: GitS-Cursors" || warn "cursor theme is '$cur' (a KDE app's kded6 syncs kcminputrc into GTK; do not flip it live, waybar/Zen can crash)"
gt=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
[[ $gt == adw-gtk3-dark ]] && ok "GTK theme: adw-gtk3-dark (+ GitS colours)" || warn "GTK theme is '$gt' (adw-gtk3-dark expected)"
# kded6 (started by any KDE app) copies kdeglobals [Icons] into these; post.py kdeglobals pins it, older files may still say breeze
for f in gtk-3.0/settings.ini gtk-4.0/settings.ini; do
    gi=$(grep -m1 '^gtk-icon-theme-name' "$H/.config/$f" 2>/dev/null | cut -d= -f2)
    [[ -z $gi || $gi == GitS-Icons ]] && ok "${f%%/*} icon theme: ${gi:-unset}" || warn "$f icon theme is '$gi' (GitS-Icons expected; gits-doctor --fix)"
done
xi=$(sed -n 's/^Net\/IconThemeName "\(.*\)"/\1/p' "$H/.config/xsettingsd/xsettingsd.conf" 2>/dev/null)
[[ -z $xi || $xi == GitS-Icons ]] && ok "xsettingsd icon theme: ${xi:-unset}" || warn "xsettingsd icon theme is '$xi' (X11 apps; gits-doctor --fix)"
kc=$(grep -m1 '^cursorTheme=' "$H/.config/kcminputrc" 2>/dev/null | cut -d= -f2)
[[ -z $kc || $kc == GitS-Cursors ]] && ok "kcminputrc cursorTheme: ${kc:-unset}" || warn "kcminputrc cursorTheme=$kc: any KDE app (KDE Connect, Dolphin) will push it into GTK settings"

# GTK4 apps hang forever while loading the theme when gtk-4.0/settings.ini says gtk-application-prefer-dark-theme=true. KDE's kded6 "gtkconfig" module keeps recreating that file.
g4=$H/.config/gtk-4.0/settings.ini
# (only when gtk-4.0 is a symlink into a generated theme dir, as with HyDE's Wallbash; a plain dir, as GitS ships it, is fine)
if [[ -f $g4 && -L $H/.config/gtk-4.0 ]] && grep -q 'gtk-application-prefer-dark-theme *= *true' "$g4"; then
    bad "$g4 has prefer-dark-theme: every GTK4 app will hang at start (rm it; kded6 gtkconfig recreates it)"
else ok "no GTK4 settings.ini that hangs GTK4 apps"; fi
if grep -A1 '^\[Module-gtkconfig\]' "$H/.config/kded6rc" 2>/dev/null | grep -q 'autoload=false'; then ok "kded6 gtkconfig module disabled"
else warn "kded6 gtkconfig module is on: KDE apps rewrite GTK settings (cursor theme, gtk-4.0/settings.ini)"; fi

# ---------------------------------------------------------------- services
head_ "processes and units"
if pgrep -x waybar >/dev/null; then ok "waybar running (pid $(pgrep -x waybar | head -1))"
elif [[ -f $H/.local/state/gits-bar-hidden ]]; then ok "waybar hidden on purpose"
else bad "waybar is not running (systemctl --user status gits-bar)"; fi

if systemctl --user is-active --quiet gits-session.target; then ok "gits-session.target active"; else bad "gits-session.target is not active (gits-session start)"; fi
for u in bar notifications idle sunset wallpaper polkit clip-text clip-image clip-persist; do
    systemctl --user is-active --quiet "gits-$u.service" || warn "gits-$u.service is not running ($(systemctl --user show "gits-$u.service" -p Result --value 2>/dev/null))"
done

if pgrep -f '[g]its-widgets/widgets.py' >/dev/null; then ok "desktop widgets running"; else warn "desktop widgets not running (~/.config/gits-widgets/run.sh start)"; fi

failed=$(systemctl --user --failed --no-legend 2>/dev/null | awk '{print $2}' | paste -sd' ' -)
[[ -z $failed ]] && ok "no failed user units" || bad "failed user units: $failed"

# every gits-* unit must belong to the CURRENT compositor (a login race can leave units of a dead one)
cursig=${HYPRLAND_INSTANCE_SIGNATURE:-}
stale=()
if [[ -n $cursig ]]; then
    while read -r u; do
        pid=$(systemctl --user show "$u" -p MainPID --value 2>/dev/null)
        [[ $pid -gt 0 ]] || continue
        [[ -r /proc/$pid/environ ]] || continue   # non-dumpable processes (polkit agent) have a root-owned environ
        sig=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -m1 '^HYPRLAND_INSTANCE_SIGNATURE=' | cut -d= -f2)
        [[ -n $sig && $sig != "$cursig" ]] && stale+=("$u")
    done < <(systemctl --user list-units 'gits-*.service' --no-legend --plain | awk '{print $1}')
    [[ ${#stale[@]} -eq 0 ]] && ok "no units left over from a dead compositor" || bad "stale units from a previous Hyprland: ${stale[*]} (gits-session restart)"
fi

# ---------------------------------------------------------------- hooks
head_ "login (hypr/gits/start.lua)"
for f in .config/hypr/gits/start.lua .config/gits-widgets/run.sh .config/hypr/scripts/gits-events.sh; do
    p=$H/$f
    if [[ ! -e $p ]]; then bad "$f is missing"
    elif [[ ${p##*.} == sh && ! -x $p ]]; then bad "$f is not executable"
    else ok "${f##*/}"; fi
done
[[ -x $H/.config/hypr/scripts/gits-blind-guard.sh ]] && ok "blind-session guard installed" || warn "blind-session guard not installed (opt-in: install.sh --login-guards)"

if grep -vE '^\s*#' "$H/.config/zsh/.zprofile" 2>/dev/null | grep -qE 'wait.*sddm|pgrep -u sddm'; then
    bad ".zprofile waits for sddm again: that blocking guard broke login on Sep 20, remove it"
else ok ".zprofile has no blocking login wait"; fi

# ---------------------------------------------------------------- theme files
head_ "theme files"
need=(
    ".config/kitty/theme.conf" ".config/gtk-3.0/gtk.css" ".config/gtk-4.0/gtk.css" ".config/Kvantum/GitS/GitS.kvconfig" ".config/qt6ct/qt6ct.conf"
    ".config/hypr/hyprland.lua" ".config/hypr/gits/options.lua" ".config/dunst/dunstrc" ".local/share/gits/wallpapers/gits_smoke.png"
    ".config/waybar/layouts/ghost-in-the-shell.jsonc" ".config/waybar/styles/ghost-in-the-shell.css"
    ".config/hypr/hyprlock.conf" ".config/hypr/hyprlock/gits_lock_bg.png"
    ".config/starship/starship.toml" ".config/zsh/gits/banner.zsh" ".config/nvim/colors/gits.lua"
    ".config/btop/themes/gits.theme" ".config/bat/themes/GitS.tmTheme" ".config/yazi/theme.toml"
    ".config/lazygit/config.yml" ".config/tmux/tmux.conf"
    ".config/wlogout/style_1.css" ".config/gits-widgets/widgets.py"
    ".local/share/icons/GitS-Cursors/index.theme"
)
miss=()
for f in "${need[@]}"; do [[ -e $H/$f ]] || miss+=("$f"); done
[[ ${#miss[@]} -eq 0 ]] && ok "${#need[@]} theme files present" || bad "missing: ${miss[*]}"

# ---------------------------------------------------------------- boot chain
head_ "boot chain (SDDM / GRUB / Plymouth)"
sd=/usr/share/sddm/themes/ghost-in-the-shell
if [[ -d $sd ]] && diff -rq "$H/.local/share/gits-sddm/ghost-in-the-shell" "$sd" >/dev/null 2>&1; then ok "SDDM theme installed and identical to staging"
elif [[ -d $sd ]]; then warn "SDDM theme installed but differs from ~/.local/share/gits-sddm (needs sudo cp)"
else bad "SDDM theme not installed"; fi
grep -rqs '^Current=ghost-in-the-shell' /etc/sddm.conf.d/ && ok "SDDM Current=ghost-in-the-shell" || warn "SDDM does not select the GitS theme"

gt=/usr/share/grub/themes/ghost-in-the-shell/theme.txt
if [[ -f $gt ]]; then
    if grep -qE '=\s*[0-9]+\.[0-9]+' "$gt"; then bad "GRUB theme.txt has decimals (grub_strtoull error at boot)"
    elif diff -q "$H/.local/share/gits-boot/staging/grub/ghost-in-the-shell/theme.txt" "$gt" >/dev/null 2>&1; then ok "GRUB theme installed, integers only, matches staging"
    else warn "GRUB theme differs from staging"; fi
else bad "GRUB theme missing"; fi
if [[ $(findmnt -T /boot/grub -no FSTYPE 2>/dev/null) == btrfs ]] && grep -qE '^GRUB_SAVEDEFAULT=true' /etc/default/grub 2>/dev/null; then
    warn "GRUB_SAVEDEFAULT=true on btrfs: GRUB prints 'sparse file not allowed / Press any key' every boot (sudo ~/.local/share/gits-boot/fix-grub-savedefault.sh)"
else ok "GRUB savedefault is not fighting btrfs"; fi
grep -q '^GRUB_THEME=.*ghost-in-the-shell' /etc/default/grub 2>/dev/null && ok "GRUB_THEME set" || warn "GRUB_THEME not set to the GitS theme"

grep -qE '^Theme=ghost-in-the-shell' /etc/plymouth/plymouthd.conf 2>/dev/null && ok "Plymouth theme: ghost-in-the-shell" || warn "Plymouth theme is not GitS"
grep -q '\bsplash\b' /proc/cmdline && ok "kernel cmdline has splash" || warn "no splash on the kernel cmdline"
if [[ -f /etc/mkinitcpio.conf ]]; then
    grep -qE '^HOOKS=.*plymouth' /etc/mkinitcpio.conf && ok "mkinitcpio has the plymouth hook" || warn "plymouth hook missing in mkinitcpio.conf"
elif command -v dracut >/dev/null; then
    grep -rqsE '^add_dracutmodules\+?=.*plymouth' /etc/dracut.conf /etc/dracut.conf.d/ && ok "dracut adds the plymouth module" || warn "dracut does not add the plymouth module (install.sh --system)"
fi

# ---------------------------------------------------------------- apps
head_ "apps"
zp=
for d in "$H"/.var/app/app.zen_browser.zen/.zen/*/; do
    [[ -f $d/user.js && -d $d/chrome ]] && { zp=${d%/}; break; }
done
[[ -z $zp ]] && zp=$(find "$H/.var/app/app.zen_browser.zen/.zen" -maxdepth 2 -name prefs.js 2>/dev/null | head -1 | xargs -r dirname)
if [[ -n $zp ]]; then
    rc=$(grep -h 'toolkit.startup.recent_crashes' "$zp/prefs.js" 2>/dev/null | grep -oE '[0-9]+\)' | tr -d ')')
    if [[ ${rc:-0} -ge 3 ]]; then warn "Zen recent_crashes=$rc: next start asks for Troubleshoot Mode (flatpak kill it, set the pref to 0 in prefs.js)"
    else ok "Zen crash counter ${rc:-0}"; fi
    [[ -f $zp/chrome/userChrome.css ]] && ok "Zen userChrome.css present" || warn "Zen userChrome.css missing"
fi
command -v tmux >/dev/null && ok "tmux installed" || warn "tmux not installed"
# GLib (launcher, gtk-launch, xdg-open) opens Terminal=true apps with xdg-terminal-exec, else gnome-terminal / konsole / xterm
command -v xdg-terminal-exec >/dev/null && ok "xdg-terminal-exec: terminal apps open in $(grep -v '^#' "$H/.config/xdg-terminals.list" 2>/dev/null | head -1 | sed 's/.desktop$//')" \
    || warn "xdg-terminal-exec not installed: nvim / btop from the launcher open in another terminal, not kitty (pacman -S xdg-terminal-exec)"
# screenshots (gits-shot) and the colour picker call grim/slurp by name: a shim earlier in PATH (e.g. /usr/local/bin/grim -> spectacle,
# left over from KDE) silently breaks them
for c in grim slurp; do
    p=$(command -v "$c") || { warn "$c not installed (screenshots)"; continue; }
    if [[ $p != /usr/bin/$c ]] && ! pacman -Qqo "$p" >/dev/null 2>&1 && grep -qI . "$p" 2>/dev/null; then
        bad "$c resolves to $p (a script, not the real $c): screenshots break; move it away (sudo mv $p $p.off)"
    else ok "$c is the real one"; fi
done

# ---------------------------------------------------------------- extras
head_ "menus, sounds, widgets extras"
miss=""; for b in gits-menu gits-wifi gits-bt gits-sound gits-panel gits-osd gits-rog gits-touchpad gits-idle gits-update gits-rec gits-focus gits-project gits-note gits-daynight gits-vol gits-bright gits-shot gits-logout gits-sysmon gits-exit; do command -v "$b" >/dev/null || miss+=" $b"; done
[[ -z $miss ]] && ok "menus and sound player in PATH (gits-wifi, gits-bt, gits-menu, gits-sound)" || warn "missing from PATH:$miss"
nw=$(ls "$H/.local/share/gits-sounds"/*.wav 2>/dev/null | wc -l)
[[ $nw -ge 7 ]] && ok "UI sounds built ($nw wav files)" || warn "UI sounds missing: python3 ~/.local/share/gits-sounds/build.py"
[[ -e $H/.local/state/gits-sounds/off ]] && warn "UI sounds are muted (gits-sound on)" || ok "UI sounds on"
n=$(grep -c 'gits/banner.zsh' "$H/.config/zsh/user.zsh" 2>/dev/null)
[[ ${n:-0} -le 1 ]] && ok "terminal banner is hooked once" || warn "banner.zsh is sourced $n times in user.zsh (fastfetch runs several times): keep only the gits block"
if command -v zsh >/dev/null; then   # the block only runs if this shell's startup files read user.zsh
    zt=$(mktemp); env -u GITS_TMUX GITS_NO_BANNER=1 GITS_NO_TMUX=1 timeout 30 zsh -ixc exit </dev/null >/dev/null 2>"$zt" || true
    grep -q 'gits/colors.zsh' "$zt" && ok "zsh runs the GitS block (~/.config/zsh/user.zsh)" || warn "zsh never runs ~/.config/zsh/user.zsh: no banner or fzf colours (re-run install.sh)"
    rm -f "$zt"
fi
[[ -r $H/.config/zsh/gits/tmux.zsh ]] && ok "tmux helper present (autostart is opt-in: GITS_TMUX=1)" || warn "gits/tmux.zsh missing"
grep -q '# >>> gits-idle' "$H/.config/hypr/hypridle.conf" 2>/dev/null && ok "sleep timers managed by gits-idle" || warn "hypridle.conf is not managed by gits-idle (run: gits-idle apply)"
pgrep -f "[g]its-events.sh" >/dev/null && ok "gits-events running (login / plug / lock sounds)" || warn "gits-events.sh is not running (started from hypr/gits/start.lua at login)"
python3 -c "import numpy" 2>/dev/null && ok "python-numpy present (audio spectrum card)" || warn "python-numpy missing: no audio spectrum card"
rmiss=(); for c in mpv socat jq curl parec pactl; do command -v "$c" >/dev/null || rmiss+=("$c"); done
[[ ${#rmiss[@]} -eq 0 ]] && ok "web radio ready (gits-radio: mpv, socat, jq, curl, parec)" || warn "gits-radio needs: ${rmiss[*]} (sudo pacman -S mpv socat jq curl libpulse)"
[[ -r $H/.config/gits-widgets/lain.gif ]] && ok "lain.gif present (the lock-screen mascot lain)" || warn "lain.gif missing in ~/.config/gits-widgets: no dancing Lain (re-run install.sh)"
[[ -L $H/.local/share/gits/art/current && -r $H/.local/share/gits/art/current/banner.conf ]] && ok "art set: $(readlink "$H/.local/share/gits/art/current") (banner, fastfetch, Neovim, radio dancer)" || warn "no art set linked at ~/.local/share/gits/art/current (re-run install.sh)"
command -v gits-theme >/dev/null && ok "colour theme: $(gits-theme current)" || warn "gits-theme missing: rerun ./install.sh"
[[ -r $H/.local/share/gits-lock/tachikoma-0.txt ]] && ok "lock screen frames built (the Tachikoma)" || warn "lock screen frames missing: python3 ~/.local/share/gits-lock/tachikoma.py"
if command -v rog-control-center >/dev/null; then
    pgrep -f "^(/usr/bin/)?rog-control-center" >/dev/null && ok "ROG Control Center running" || warn "ROG Control Center installed but not running"
fi
if command -v snapper >/dev/null; then
    tl=$(systemctl is-enabled snapper-timeline.timer 2>/dev/null)
    [[ $tl == enabled ]] && ok "snapper timeline snapshots enabled" || warn "snapper timeline is $tl (sudo ~/.local/share/gits-snap/setup.sh)"
fi

# ---------------------------------------------------------------- login history
head_ "login history"
lg=$H/.local/state/gits-login.log
if [[ -f $lg ]]; then
    n=$(grep -c "wayland session" "$lg")
    ok "$n logins recorded, last: $(tail -1 "$lg")"
fi
if [[ $LOGS == 1 ]]; then
    printf '%s-- gits-login.log%s\n' "$C_DIM" "$C_0"; tail -8 "$lg" 2>/dev/null
    printf '%s-- sddm journal (this boot)%s\n' "$C_DIM" "$C_0"; journalctl -b -u sddm --no-pager -q 2>/dev/null | tail -12
fi

# ---------------------------------------------------------------- repairs
if [[ $FIX == 1 ]]; then
    printf '\n%s// repairs%s\n' "$C_B" "$C_0"
    FIXED=0
    fixed() { FIXED=$((FIXED + 1)); printf '  %s[fix ]%s %s\n' "$C_OK" "$C_0" "$1"; }
    failed_fix() { printf '  %s[FAIL]%s could not: %s\n' "$C_BAD" "$C_0" "$1"; }
    g4=$H/.config/gtk-4.0/settings.ini
    if [[ -f $g4 && -L $H/.config/gtk-4.0 ]] && grep -q 'gtk-application-prefer-dark-theme *= *true' "$g4"; then rm -f "$g4" && fixed "removed the GTK4 settings.ini that hangs GTK4 apps"; fi
    if ! grep -A1 '^\[Module-gtkconfig\]' "$H/.config/kded6rc" 2>/dev/null | grep -q 'autoload=false'; then
        printf '\n[Module-gtkconfig]\nautoload=false\n' >>"$H/.config/kded6rc" && fixed "kded6 gtkconfig module switched off (restart kded6 or re-login to apply)"
    fi
    for f in gtk-3.0/settings.ini gtk-4.0/settings.ini; do
        gi=$(grep -m1 '^gtk-icon-theme-name' "$H/.config/$f" 2>/dev/null | cut -d= -f2)
        if [[ -n $gi && $gi != GitS-Icons ]]; then sed -i 's/^gtk-icon-theme-name=.*/gtk-icon-theme-name=GitS-Icons/' "$H/.config/$f" && fixed "${f%%/*} icon theme $gi -> GitS-Icons"; fi
    done
    xs=$H/.config/xsettingsd/xsettingsd.conf
    if [[ -f $xs ]] && grep -q '^Net/IconThemeName' "$xs" && ! grep -q '^Net/IconThemeName "GitS-Icons"' "$xs"; then
        sed -i 's/^Net\/IconThemeName .*/Net\/IconThemeName "GitS-Icons"/' "$xs" && { pkill -HUP -x xsettingsd 2>/dev/null; fixed "xsettingsd icon theme -> GitS-Icons"; }
    fi
    kc=$(grep -m1 '^cursorTheme=' "$H/.config/kcminputrc" 2>/dev/null | cut -d= -f2)
    if [[ -n $kc && $kc != GitS-Cursors ]]; then sed -i 's/^cursorTheme=.*/cursorTheme=GitS-Cursors/' "$H/.config/kcminputrc" && fixed "kcminputrc cursorTheme $kc -> GitS-Cursors"; fi
    pgrep -f '[g]its-widgets/widgets.py' >/dev/null || { "$H/.config/gits-widgets/run.sh" start </dev/null >/dev/null 2>&1 && fixed "desktop widgets started"; }
    pgrep -f '[g]its-widgets/osd.py' >/dev/null || { command -v gits-osd >/dev/null && gits-osd start </dev/null >/dev/null 2>&1 && fixed "OSD daemon started"; }
    pgrep -f '[g]its-events.sh' >/dev/null || { [[ -x $H/.config/hypr/scripts/gits-events.sh ]] && GITS_EVENTS_NO_LOGIN=1 setsid -f "$H/.config/hypr/scripts/gits-events.sh" </dev/null >/dev/null 2>&1 && fixed "events daemon started (sounds)"; }
    nw=$(ls "$H/.local/share/gits-sounds"/*.wav 2>/dev/null | wc -l)
    [[ $nw -ge 7 ]] || { python3 "$H/.local/share/gits-sounds/build.py" >/dev/null 2>&1 && fixed "UI sounds rebuilt"; }
    if [[ -n $(systemctl --user --failed --no-legend 2>/dev/null) ]]; then systemctl --user reset-failed && fixed "failed user units reset (then check again: they may fail again)"; fi
    command -v dunstctl >/dev/null && dunstctl reload 2>/dev/null
    (( FIXED )) && printf '  %d repair(s) done: run gits-doctor again\n' "$FIXED" || printf '  nothing to repair\n'
fi

printf '\n%s%d ok%s, %s%d warn%s, %s%d fail%s\n' "$C_OK" "$OKS" "$C_0" "$C_WARN" "$WARNS" "$C_0" "$C_BAD" "$FAILS" "$C_0"
exit "$FAILS"
