#!/usr/bin/env bash
# gits-doctor: one-shot health report for the Ghost in the Shell desktop customisations.
# Read-only: it never restarts anything. Exit code = number of FAILs.
#   gits-doctor          full report
#   gits-doctor -q       only WARN/FAIL lines
#   gits-doctor -l       also show the tail of the login breadcrumb log and the SDDM journal
#   gits-doctor --fix    after the report, repair what HyDE updates / KDE apps / crashes typically undo (see the end of this
#                        file): preset selections, GTK4 hang, kded6 gtkconfig, cursor sync, dead helpers, failed units.
#                        Never touches the workflow (you may be gaming), login hooks, or anything needing sudo.
set -u

QUIET=0; LOGS=0; FIX=0
for a in "$@"; do case $a in -q) QUIET=1 ;; -l) LOGS=1 ;; -f|--fix) FIX=1 ;; esac; done

if [[ -t 1 ]]; then
    C_OK=$'\e[38;2;46;211;215m'; C_WARN=$'\e[38;2;240;200;80m'; C_BAD=$'\e[38;2;240;80;80m'
    C_DIM=$'\e[2m'; C_B=$'\e[1m'; C_0=$'\e[0m'
else
    C_OK= C_WARN= C_BAD= C_DIM= C_B= C_0=
fi
FAILS=0 WARNS=0 OKS=0

ok()   { OKS=$((OKS + 1));     [[ $QUIET == 1 ]] || printf '  %s[ ok ]%s %s\n' "$C_OK" "$C_0" "$1"; }
warn() { WARNS=$((WARNS + 1)); printf '  %s[warn]%s %s\n' "$C_WARN" "$C_0" "$1"; }
bad()  { FAILS=$((FAILS + 1)); printf '  %s[FAIL]%s %s\n' "$C_BAD" "$C_0" "$1"; }
head_() { [[ $QUIET == 1 ]] || printf '\n%s// %s%s\n' "$C_B" "$1" "$C_0"; }

H=$HOME
RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# ---------------------------------------------------------------- session
head_ "session"
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && ! hyprctl version >/dev/null 2>&1; then
    bad "Hyprland is not reachable from this shell (run gits-doctor inside the session)"
else
    mons=$(hyprctl monitors -j 2>/dev/null | jq 'length' 2>/dev/null || echo 0)
    if [[ ${mons:-0} -ge 1 ]]; then
        desc=$(hyprctl monitors -j | jq -r '.[] | "\(.name) \(.width)x\(.height)@\(.refreshRate|floor)"' | paste -sd, -)
        ok "monitors: $desc"
    else
        bad "Hyprland has 0 monitors (blind session: the AMD/NVIDIA login race)"
    fi

    errs=$(hyprctl configerrors 2>/dev/null | sed '/^$/d')
    if [[ -z $errs ]]; then ok "no Hyprland config errors"; else bad "config errors: $(head -c 200 <<<"$errs")"; fi

    ndirs=$(find "$RUN/hypr" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    if [[ $ndirs -le 1 ]]; then ok "single Hyprland instance dir"
    else warn "$ndirs Hyprland instance dirs in $RUN/hypr (the session restarted at least once)"; fi
fi

# ---------------------------------------------------------------- hyde state
head_ "HyDE state"
st=$H/.local/state/hyde/staterc
getst() { grep -m1 "^$1=" "$st" 2>/dev/null | cut -d= -f2- | tr -d '"'; }
[[ $(getst HYDE_THEME) == "Ghost in the Shell" ]] && ok "theme: Ghost in the Shell" || warn "theme is '$(getst HYDE_THEME)'"
wf=$(getst HYPR_WORKFLOW)
if [[ $wf == 01-default ]]; then ok "workflow: default"
else warn "workflow is '$wf': it overrides parts of the GitS look (gaps/blur/animations). Back: hyde-shell workflows --set 01-default"; fi
[[ $(getst HYPR_ANIMATION) == gits ]] && ok "animation preset: gits" || warn "animation preset is '$(getst HYPR_ANIMATION)'"
[[ $(getst HYPRLOCK_LAYOUT) == "Ghost in the Shell" ]] && ok "hyprlock layout: Ghost in the Shell" || warn "hyprlock layout is '$(getst HYPRLOCK_LAYOUT)'"
[[ $(getst WAYBAR_LAYOUT_NAME) == ghost-in-the-shell ]] && ok "waybar layout: ghost-in-the-shell" || warn "waybar layout is '$(getst WAYBAR_LAYOUT_NAME)'"
cur=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")
[[ $cur == GitS-Cursors ]] && ok "cursor theme: GitS-Cursors" || warn "cursor theme is '$cur' (a KDE app's kded6 syncs kcminputrc into GTK; do not flip it live, waybar/Zen can crash)"
kc=$(grep -m1 '^cursorTheme=' "$H/.config/kcminputrc" 2>/dev/null | cut -d= -f2)
[[ -z $kc || $kc == GitS-Cursors ]] && ok "kcminputrc cursorTheme: ${kc:-unset}" || warn "kcminputrc cursorTheme=$kc: any KDE app (KDE Connect, Dolphin) will push it into GTK settings"

# GTK4 apps hang forever while loading the theme when gtk-4.0/settings.ini (inside the theme dir, ~/.config/gtk-4.0 is a
# symlink to it) says gtk-application-prefer-dark-theme=true. KDE's kded6 "gtkconfig" module keeps recreating that file.
g4=$H/.config/gtk-4.0/settings.ini
if [[ -f $g4 ]] && grep -q 'gtk-application-prefer-dark-theme *= *true' "$g4"; then
    bad "$g4 has prefer-dark-theme: every GTK4 app will hang at start (rm it; kded6 gtkconfig recreates it)"
else ok "no GTK4 settings.ini that hangs GTK4 apps"; fi
if grep -A1 '^\[Module-gtkconfig\]' "$H/.config/kded6rc" 2>/dev/null | grep -q 'autoload=false'; then ok "kded6 gtkconfig module disabled"
else warn "kded6 gtkconfig module is on: KDE apps rewrite GTK settings (cursor theme, gtk-4.0/settings.ini)"; fi

# ---------------------------------------------------------------- services
head_ "processes and units"
if pgrep -x waybar >/dev/null; then ok "waybar running (pid $(pgrep -x waybar | head -1))"
elif [[ -f $H/.local/state/hyde/waybar.hidden || -f $H/.local/state/gits-bar-hidden ]]; then ok "waybar hidden on purpose"
else bad "waybar is not running (hyde-shell waybar.py --watch)"; fi

res=$(systemctl --user show hyde-Hyprland-bar.service -p Result --value 2>/dev/null)
[[ -z $res || $res == success ]] && ok "bar unit Result: ${res:-n/a}" || warn "bar unit Result=$res (a crash; the watchdog should revive it)"

pgrep -f '[g]its-watchdog.sh' >/dev/null && ok "waybar watchdog running" || bad "gits-watchdog.sh is not running"

if pgrep -f '[g]its-widgets/widgets.py' >/dev/null; then ok "desktop widgets running"; else warn "desktop widgets not running (~/.config/gits-widgets/run.sh start)"; fi

failed=$(systemctl --user --failed --no-legend 2>/dev/null | awk '{print $2}' | paste -sd' ' -)
[[ -z $failed ]] && ok "no failed user units" || bad "failed user units: $failed"

# every hyde-Hyprland-* unit must belong to the CURRENT compositor (login race leaves stale ones)
cursig=${HYPRLAND_INSTANCE_SIGNATURE:-}
stale=()
if [[ -n $cursig ]]; then
    while read -r u; do
        pid=$(systemctl --user show "$u" -p MainPID --value 2>/dev/null)
        [[ $pid -gt 0 ]] || continue
        sig=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | grep -m1 '^HYPRLAND_INSTANCE_SIGNATURE=' | cut -d= -f2)
        [[ -n $sig && $sig != "$cursig" ]] && stale+=("$u")
    done < <(systemctl --user list-units 'hyde-Hyprland-*.service' --no-legend --plain | awk '{print $1}')
    [[ ${#stale[@]} -eq 0 ]] && ok "no units left over from a dead compositor" || bad "stale units from a previous Hyprland: ${stale[*]}"
fi

# ---------------------------------------------------------------- hooks
head_ "login hooks (hyprland.lua / gits.lua)"
hooks=$(cat "$H/.config/hypr/hyprland.lua" "$H/.config/hypr/gits.lua" 2>/dev/null)   # the gits.lua block is what install.sh adds
for pair in "gits-watchdog.sh:waybar watchdog" "gits-stale-guard.sh:stale-unit guard" "gits-blind-guard.sh:blind-session guard" \
            "gits-widgets/run.sh:widgets autostart" "gits-workspaces.lua:workspace rules"; do
    f=${pair%%:*}; n=${pair#*:}
    if ! grep -q "$f" <<<"$hooks"; then
        if [[ $f == gits-blind-guard.sh ]]; then warn "$n is not hooked (opt-in: install.sh --login-guards)"; else bad "$n is not hooked in hyprland.lua / gits.lua"; fi
    else
        p=$(find "$H/.config" -name "${f##*/}" -type f 2>/dev/null | head -1)
        if [[ -z $p ]]; then bad "$n hooked, but ${f##*/} is missing"
        elif [[ ${p##*.} == sh && ! -x $p ]]; then bad "$n: $p is not executable"
        else ok "$n"; fi
    fi
done
grep -q "sleep 10; pgrep -x waybar" <<<"$hooks" && ok "waybar login-race guard" || warn "waybar login-race guard missing"

if grep -vE '^\s*#' "$H/.config/zsh/.zprofile" 2>/dev/null | grep -qE 'wait.*sddm|pgrep -u sddm'; then
    bad ".zprofile waits for sddm again: that blocking guard broke login on Sep 20, remove it"
else ok ".zprofile has no blocking login wait"; fi

# ---------------------------------------------------------------- theme files
head_ "theme files"
need=(
    ".config/hyde/themes/Ghost in the Shell/theme.dcol"
    ".config/waybar/layouts/ghost-in-the-shell.jsonc" ".config/waybar/styles/ghost-in-the-shell.css"
    ".config/hypr/hyprlock/Ghost in the Shell.conf" ".config/hypr/hyprlock/gits_lock_bg.png"
    ".config/starship/starship.toml" ".config/zsh/gits/banner.zsh" ".config/nvim/colors/gits.lua"
    ".config/btop/themes/gits.theme" ".config/bat/themes/GitS.tmTheme" ".config/yazi/theme.toml"
    ".config/lazygit/config.yml" ".config/tmux/tmux.conf" ".config/rofi/theme.rasi"
    ".config/rofi/themes/style_1.rasi" ".config/wlogout/style_1.css" ".config/gits-widgets/widgets.py"
    ".local/share/icons/GitS-Cursors/index.theme"
)
miss=()
for f in "${need[@]}"; do [[ -e $H/$f ]] || miss+=("$f"); done
[[ ${#miss[@]} -eq 0 ]] && ok "${#need[@]} theme files present" || bad "missing: ${miss[*]}"

# broken symlinks in the rofi themes dir would silently drop a launcher style
brk=$(find "$H/.local/share/rofi/themes" -xtype l 2>/dev/null | wc -l)
[[ $brk -eq 0 ]] && ok "rofi theme symlinks resolve" || warn "$brk broken rofi theme symlinks"

# ---------------------------------------------------------------- boot chain
head_ "boot chain (SDDM / GRUB / Plymouth)"
sd=/usr/share/sddm/themes/ghost-in-the-shell
if [[ -d $sd ]] && diff -rq "$H/.local/share/gits-sddm/ghost-in-the-shell" "$sd" >/dev/null 2>&1; then ok "SDDM theme installed and identical to staging"
elif [[ -d $sd ]]; then warn "SDDM theme installed but differs from ~/.local/share/gits-sddm (needs sudo cp)"
else bad "SDDM theme not installed"; fi
grep -rqs '^Current=ghost-in-the-shell' /etc/sddm.conf.d/ && ok "SDDM Current=ghost-in-the-shell" || warn "SDDM does not select the GitS theme"

gt=/usr/share/grub/themes/ghost-in-the-shell/theme.txt
if [[ -f $gt ]]; then
    if grep -qE '=\s*[0-9]+\.[0-9]+' "$gt"; then bad "GRUB theme.txt has decimals (grub_strtoull error at boot)"
    elif diff -q "$H/.local/share/gits-boot/staging/grub/ghost-in-the-shell/theme.txt" "$gt" >/dev/null 2>&1; then ok "GRUB theme installed, integers only, matches staging"
    else warn "GRUB theme differs from staging"; fi
else bad "GRUB theme missing"; fi
if [[ $(findmnt -T /boot/grub -no FSTYPE 2>/dev/null) == btrfs ]] && grep -qE '^GRUB_SAVEDEFAULT=true' /etc/default/grub 2>/dev/null; then
    warn "GRUB_SAVEDEFAULT=true on btrfs: GRUB prints 'sparse file not allowed / Press any key' every boot (sudo ~/.local/share/gits-boot/fix-grub-savedefault.sh)"
else ok "GRUB savedefault is not fighting btrfs"; fi
grep -q '^GRUB_THEME=.*ghost-in-the-shell' /etc/default/grub 2>/dev/null && ok "GRUB_THEME set" || warn "GRUB_THEME not set to the GitS theme"

grep -qE '^Theme=ghost-in-the-shell' /etc/plymouth/plymouthd.conf 2>/dev/null && ok "Plymouth theme: ghost-in-the-shell" || warn "Plymouth theme is not GitS"
grep -q '\bsplash\b' /proc/cmdline && ok "kernel cmdline has splash" || warn "no splash on the kernel cmdline"
grep -qE '^HOOKS=.*plymouth' /etc/mkinitcpio.conf 2>/dev/null && ok "mkinitcpio has the plymouth hook" || warn "plymouth hook missing in mkinitcpio.conf"

# ---------------------------------------------------------------- apps
head_ "apps"
zp=
for d in "$H"/.var/app/app.zen_browser.zen/.zen/*/; do
    [[ -f $d/user.js && -d $d/chrome ]] && { zp=${d%/}; break; }
done
[[ -z $zp ]] && zp=$(find "$H/.var/app/app.zen_browser.zen/.zen" -maxdepth 2 -name prefs.js 2>/dev/null | head -1 | xargs -r dirname)
if [[ -n $zp ]]; then
    rc=$(grep -h 'toolkit.startup.recent_crashes' "$zp/prefs.js" 2>/dev/null | grep -oE '[0-9]+\)' | tr -d ')')
    if [[ ${rc:-0} -ge 3 ]]; then warn "Zen recent_crashes=$rc: next start asks for Troubleshoot Mode (flatpak kill it, set the pref to 0 in prefs.js)"
    else ok "Zen crash counter ${rc:-0}"; fi
    [[ -f $zp/chrome/userChrome.css ]] && ok "Zen userChrome.css present" || warn "Zen userChrome.css missing"
fi
command -v tmux >/dev/null && ok "tmux installed" || warn "tmux not installed"

# ---------------------------------------------------------------- extras
head_ "menus, sounds, widgets extras"
miss=""; for b in gits-menu gits-wifi gits-bt gits-sound; do command -v "$b" >/dev/null || miss+=" $b"; done
[[ -z $miss ]] && ok "menus and sound player in PATH (gits-wifi, gits-bt, gits-menu, gits-sound)" || warn "missing from PATH:$miss"
nw=$(ls "$H/.local/share/gits-sounds"/*.wav 2>/dev/null | wc -l)
[[ $nw -ge 7 ]] && ok "UI sounds built ($nw wav files)" || warn "UI sounds missing: python3 ~/.local/share/gits-sounds/build.py"
[[ -e $H/.local/state/gits-sounds/off ]] && warn "UI sounds are muted (gits-sound on)" || ok "UI sounds on"
n=$(grep -c 'gits/banner.zsh' "$H/.config/zsh/user.zsh" 2>/dev/null)
[[ ${n:-0} -le 1 ]] && ok "terminal banner is hooked once" || warn "banner.zsh is sourced $n times in user.zsh (fastfetch runs several times): keep only the gits-hyde block"
n=$(cat "$H/.config/hypr/hyprland.lua" "$H/.config/hypr/gits.lua" 2>/dev/null | grep -c 'gits-widgets/run.sh start')
[[ ${n:-0} -le 1 ]] && ok "Hyprland hooks are not duplicated" || warn "widgets are started $n times (hyprland.lua and gits.lua both hook them): remove the inline copies"
[[ -r $H/.config/zsh/gits/tmux.zsh ]] && ok "tmux autostart present (GITS_NO_TMUX=1 disables)" || warn "gits/tmux.zsh missing: no tmux by default"
pgrep -f "[g]its-layer-watch" >/dev/null && ok "click-away watcher running (rofi menus close on outside click)" || warn "gits-layer-watch.sh is not running (rofi menus only close with Esc)"
pgrep -f "[g]its-events.sh" >/dev/null && ok "gits-events running (login / plug / lock sounds)" || warn "gits-events.sh is not running (started from gits.lua at login)"
python3 -c "import numpy" 2>/dev/null && ok "python-numpy present (audio spectrum card)" || warn "python-numpy missing: no audio spectrum card"
grep -q "gits-events" "$H/.config/hypr/gits.lua" 2>/dev/null && ok "gits.lua hooks the events daemon" || warn "gits.lua does not hook gits-events.sh"
if command -v rog-control-center >/dev/null; then
    pgrep -f "^/usr/bin/rog-control-center" >/dev/null && ok "ROG Control Center running" || warn "ROG Control Center installed but not running"
fi
if command -v snapper >/dev/null; then
    tl=$(systemctl is-enabled snapper-timeline.timer 2>/dev/null)
    [[ $tl == enabled ]] && ok "snapper timeline snapshots enabled" || warn "snapper timeline is $tl (sudo ~/.local/share/gits-snap/setup.sh)"
fi

# ---------------------------------------------------------------- login history
head_ "login history"
lg=$H/.local/state/gits-login.log
if [[ -f $lg ]]; then
    n=$(grep -c "wayland session" "$lg")
    ok "$n logins recorded, last: $(tail -1 "$lg")"
fi
if [[ $LOGS == 1 ]]; then
    printf '%s-- gits-login.log%s\n' "$C_DIM" "$C_0"; tail -8 "$lg" 2>/dev/null
    printf '%s-- sddm journal (this boot)%s\n' "$C_DIM" "$C_0"; journalctl -b -u sddm --no-pager -q 2>/dev/null | tail -12
fi

# ---------------------------------------------------------------- repairs
if [[ $FIX == 1 ]]; then
    printf '\n%s// repairs%s\n' "$C_B" "$C_0"
    FIXED=0
    fixed() { FIXED=$((FIXED + 1)); printf '  %s[fix ]%s %s\n' "$C_OK" "$C_0" "$1"; }
    failed_fix() { printf '  %s[FAIL]%s could not: %s\n' "$C_BAD" "$C_0" "$1"; }
    setst() { sed -i "s|^$1=.*|$1=\"$2\"|" "$st"; }

    [[ $(getst HYPR_ANIMATION) == gits ]] || { hyde-shell animations --set gits >/dev/null 2>&1 && fixed "animation preset -> gits" || failed_fix "animation preset"; }
    [[ $(getst WAYBAR_LAYOUT_NAME) == ghost-in-the-shell ]] || { hyde-shell waybar.py --set ghost-in-the-shell >/dev/null 2>&1 && fixed "waybar layout -> ghost-in-the-shell" || failed_fix "waybar layout"; }
    if [[ $(getst HYPRLOCK_LAYOUT) != "Ghost in the Shell" ]]; then
        setst HYPRLOCK_LAYOUT "Ghost in the Shell"; hyde-shell hyprlock.sh --reload >/dev/null 2>&1; fixed "hyprlock layout -> Ghost in the Shell"
    fi
    g4=$H/.config/gtk-4.0/settings.ini
    if [[ -f $g4 ]] && grep -q 'gtk-application-prefer-dark-theme *= *true' "$g4"; then rm -f "$g4" && fixed "removed the GTK4 settings.ini that hangs GTK4 apps"; fi
    if ! grep -A1 '^\[Module-gtkconfig\]' "$H/.config/kded6rc" 2>/dev/null | grep -q 'autoload=false'; then
        printf '\n[Module-gtkconfig]\nautoload=false\n' >>"$H/.config/kded6rc" && fixed "kded6 gtkconfig module switched off (restart kded6 or re-login to apply)"
    fi
    kc=$(grep -m1 '^cursorTheme=' "$H/.config/kcminputrc" 2>/dev/null | cut -d= -f2)
    if [[ -n $kc && $kc != GitS-Cursors ]]; then sed -i 's/^cursorTheme=.*/cursorTheme=GitS-Cursors/' "$H/.config/kcminputrc" && fixed "kcminputrc cursorTheme $kc -> GitS-Cursors"; fi
    pgrep -f '[g]its-widgets/widgets.py' >/dev/null || { "$H/.config/gits-widgets/run.sh" start </dev/null >/dev/null 2>&1 && fixed "desktop widgets started"; }
    pgrep -f '[g]its-layer-watch' >/dev/null || { [[ -x $H/.config/hypr/scripts/gits-layer-watch.sh ]] && setsid -f "$H/.config/hypr/scripts/gits-layer-watch.sh" </dev/null >/dev/null 2>&1 && fixed "click-away watcher started"; }
    pgrep -f '[g]its-widgets/osd.py' >/dev/null || { command -v gits-osd >/dev/null && gits-osd start </dev/null >/dev/null 2>&1 && fixed "OSD daemon started"; }
    pgrep -f '[g]its-events.sh' >/dev/null || { [[ -x $H/.config/hypr/scripts/gits-events.sh ]] && GITS_EVENTS_NO_LOGIN=1 setsid -f "$H/.config/hypr/scripts/gits-events.sh" </dev/null >/dev/null 2>&1 && fixed "events daemon started (sounds)"; }
    pgrep -f '[g]its-watchdog.sh' >/dev/null || { [[ -x $H/.config/waybar/scripts/gits-watchdog.sh ]] && setsid -f "$H/.config/waybar/scripts/gits-watchdog.sh" </dev/null >/dev/null 2>&1 && fixed "waybar watchdog started"; }
    nw=$(ls "$H/.local/share/gits-sounds"/*.wav 2>/dev/null | wc -l)
    [[ $nw -ge 7 ]] || { python3 "$H/.local/share/gits-sounds/build.py" >/dev/null 2>&1 && fixed "UI sounds rebuilt"; }
    if [[ -n $(systemctl --user --failed --no-legend 2>/dev/null) ]]; then systemctl --user reset-failed && fixed "failed user units reset (then check again: they may fail again)"; fi
    command -v dunstctl >/dev/null && dunstctl reload 2>/dev/null
    (( FIXED )) && printf '  %d repair(s) done: run gits-doctor again\n' "$FIXED" || printf '  nothing to repair\n'
fi

printf '\n%s%d ok%s, %s%d warn%s, %s%d fail%s\n' "$C_OK" "$OKS" "$C_0" "$C_WARN" "$WARNS" "$C_0" "$C_BAD" "$FAILS" "$C_0"
exit "$FAILS"
