#!/usr/bin/env bash
# gits-menu TITLE TAG [rofi args...]  <lines on stdin>  ->  chosen line on stdout (exit 1 = cancelled)
# Ghost in the Shell list menu (style: ~/.config/rofi/themes/gits-menu.rasi). Used by gits-wifi, gits-bt, gits-perf.
title=${1:?title} tag=${2:-} ; shift 2
esc() { printf '%s' "$1" | sed 's/[\\"]/\\&/g'; }
exec rofi -dmenu -i -no-custom -theme "$HOME/.config/rofi/themes/gits-menu.rasi" -p "//" \
    -theme-str "textbox-title { content: \"$(esc "$title")\"; }" -theme-str "textbox-tag { content: \"$(esc "$tag")\"; }" "$@"
