#!/usr/bin/env bash
# gits-menu TITLE TAG [-format i | --password | --text]   <lines on stdin>  ->  choice on stdout (exit 1 = cancelled)
# Ghost in the Shell list menu: a GTK popup (panel.py menu), NOT rofi, so it closes on Esc and on a click outside it.
# Default output is the chosen line; -format i prints its index; --password shows a hidden text entry, --text a visible one (no stdin needed).
# Other rofi-style options are accepted and ignored. Used by gits-wifi, gits-bt, gits-perf and the dunst action menu.
title=${1:?title} tag=${2:-}; shift 2
kind=line
while (($#)); do
    case $1 in
        -format) [[ ${2:-} == i ]] && kind=index; shift 2 ;;
        -password|--password) kind=password; shift ;;
        -text|--text) kind=text; shift ;;
        -filter|-select|-p|-theme|-theme-str|-display-columns|-display-column-separator) shift 2 ;;
        *) shift ;;
    esac
done
# the warm spare of gits-panel.service; in the background so that killing gits-menu reaches the client (it closes the popup):
# bash would wait for a foreground child before running the trap
python3 "$HOME/.config/gits-widgets/popupd.py" open menu "$title" "$tag" "$kind" <&0 & client=$!
trap 'kill "$client" 2>/dev/null' TERM INT HUP
wait "$client"; rc=$?
trap - TERM INT HUP
((rc == 75)) || exit $rc   # 75 = no spare: start cold
ls_lib=/usr/lib/libgtk4-layer-shell.so; [[ -e $ls_lib ]] && export LD_PRELOAD="$ls_lib${LD_PRELOAD:+ $LD_PRELOAD}"   # spares panel.py its re-exec
exec python3 "$HOME/.config/gits-widgets/panel.py" menu "$title" "$tag" "$kind"
