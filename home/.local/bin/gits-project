#!/usr/bin/env bash
# gits-project: open a project from a menu (Super+O). Lists git repos and Godot projects below $HOME (depth 3, hidden folders skipped),
# the most recently worked-on first (last commit, or the project.godot mtime). Enter opens a kitty in the folder; a Godot project also
# starts the editor. Extra roots: GITS_PROJECT_ROOTS="$HOME/work:$HOME/src". `gits-project --list` prints the menu lines.
roots=("$HOME"); IFS=: read -ra more <<<"${GITS_PROJECT_ROOTS:-}"; roots+=("${more[@]}")
list() {
    local r d ts
    for r in "${roots[@]}"; do
        [[ -d $r ]] || continue
        find "$r" -maxdepth 3 \( -name '.*' -not -name .git -not -name . \) -prune -o \( -name .git -o -name project.godot \) -print 2>/dev/null
    done | sed 's|/\.git$||; s|/project\.godot$||' | sort -u | while IFS= read -r d; do
        if [[ -f $d/project.godot ]]; then icon=$'\U000F0297'; ts=$(stat -c %Y "$d/project.godot")   # gamepad
        else icon=$'\ue702'; ts=$(git -C "$d" log -1 --format=%ct 2>/dev/null || echo 0); fi              # git
        [[ -f $d/project.godot && -d $d/.git ]] && ts=$(git -C "$d" log -1 --format=%ct 2>/dev/null || echo "$ts")
        printf '%s\t%s\t%s\t%s\n' "$ts" "$icon" "$(basename "$d")" "$d"
    done | sort -rn
}
fmt_age() { local s=$(( $(date +%s) - $1 )); if ((s < 3600)); then echo "$((s / 60))m"; elif ((s < 86400)); then echo "$((s / 3600))h"; elif ((s < 2592000)); then echo "$((s / 86400))d"; else echo "$((s / 2592000))mo"; fi; }
# working-tree state of a git repo in one glance: ●N changed files, ↑N unpushed commits, ↓N behind the remote, ✓ clean
status_of() {
    local d=$1 out head rest dirty ahead behind s=""
    [[ -e $d/.git ]] || return 0
    out=$(timeout 3 git -C "$d" status --porcelain=v1 -b 2>/dev/null) || return 0
    head=${out%%$'\n'*}; dirty=0; [[ $out == *$'\n'* ]] && dirty=$(grep -c . <<<"${out#*$'\n'}")
    ahead=$(sed -n 's/.*ahead \([0-9]*\).*/\1/p' <<<"$head"); behind=$(sed -n 's/.*behind \([0-9]*\).*/\1/p' <<<"$head")
    ((dirty)) && s+="●$dirty "; [[ -n $ahead ]] && s+="↑$ahead "; [[ -n $behind ]] && s+="↓$behind "
    printf '%s' "${s:-✓}"
}
mapfile -t rows < <(list)
if [[ ${1:-} == --tsv ]]; then for r in "${rows[@]}"; do IFS=$'\t' read -r _ _ name dir <<<"$r"; kind=git; [[ -f $dir/project.godot ]] && kind=godot; printf '%s\t%s\t%s\n' "$name" "$dir" "$kind"; done; exit 0; fi
labels=(); dirs=(); tmp=$(mktemp -d)
for i in "${!rows[@]}"; do
    IFS=$'\t' read -r _ _ _ d <<<"${rows[i]}"; dirs+=("$d")
    ( status_of "$d" >"$tmp/$i" 2>/dev/null </dev/null ) &       # all repos at once: the menu waits for the slowest, not the sum
done
wait
for i in "${!rows[@]}"; do
    IFS=$'\t' read -r ts icon name dir <<<"${rows[i]}"
    labels+=("$(printf '%s  %-28.28s %-34.34s %-5s %s' "$icon" "$name" "${dir/#$HOME/\~}" "$(fmt_age "$ts")" "$(cat "$tmp/$i" 2>/dev/null)")")
done
rm -rf "$tmp"
if [[ ${1:-} == --list ]]; then printf '%s\n' "${labels[@]}"; exit 0; fi
open_project() { local d=$1; setsid -f kitty --directory "$d" </dev/null >/dev/null 2>&1; [[ -f $d/project.godot ]] && command -v godot >/dev/null && setsid -f godot --editor --path "$d" </dev/null >/dev/null 2>&1; }
if [[ ${1:-} == --open ]]; then open_project "${2:?directory}"; exit 0; fi
((${#labels[@]})) || { notify-send -a GitS "No projects found" "no git repo or Godot project below $HOME"; exit 1; }
idx=$(printf '%s\n' "${labels[@]}" | gits-menu $'\U000F024B  PROJECTS' "// 案件" -format i) || exit 0
open_project "${dirs[idx]}"
exit 0
