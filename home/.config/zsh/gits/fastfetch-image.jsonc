// Info column next to the image banner (used by banner.zsh in image mode, not the main fastfetch config)
{
  "display": { "separator": " │ ", "color": { "keys": "blue", "separator": "blue" }, "key": { "width": 10 } },
  "modules": [
    { "type": "command", "key": " ", "keyWidth": 0, "text": "cat ~/.local/share/gits/art/current/title 2>/dev/null || echo 'SECTION 9 // PUBLIC SECURITY'", "format": "\u001b[34m┌─[ \u001b[94m{}\u001b[34m ]" },
    { "type": "custom", "format": "\u001b[34m│" },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PKGS", "format": "{pacman}" },
    { "type": "shell", "key": "SHELL" },
    { "type": "terminal", "key": "TERM" },
    { "type": "cpu", "key": "CPU", "format": "{cores-logical} threads @ {freq-max}" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK" },
    { "type": "custom", "format": "\u001b[34m└──────────────────────" }
  ]
}
