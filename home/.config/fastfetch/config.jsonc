// Ghost in the Shell: plain `fastfetch` looks like the terminal banner (same art, same frame).
// Art and title: the colour theme's art set, ~/.local/share/gits/art/current/ (banner.png, title)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/gits/art/current/banner.png",
    "type": "kitty-direct",
    "height": 20,
    "width": 32,
    "padding": { "right": 3 }
  },
  "display": { "separator": " │ ", "color": { "keys": "blue", "separator": "blue" }, "key": { "width": 7 } },
  "modules": [
    { "type": "command", "key": " ", "keyWidth": 0, "text": "cat ~/.local/share/gits/art/current/title 2>/dev/null || echo 'SECTION 9 // PUBLIC SECURITY'", "format": "\u001b[34m┌─[ \u001b[94m{}\u001b[34m ]" },
    { "type": "custom", "format": "\u001b[34m│" },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PKGS", "format": "{pacman}" },
    { "type": "shell", "key": "SHELL" },
    { "type": "terminal", "key": "TERM" },
    { "type": "wm", "key": "WM" },
    { "type": "cpu", "key": "CPU", "format": "{cores-logical} threads @ {freq-max}" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK" },
    { "type": "custom", "format": "\u001b[34m└──────────────────────" }
  ]
}
