// Ghost in the Shell: plain `fastfetch` looks like the terminal banner (same art, same frame).
// Art: ~/.config/zsh/gits/art.png
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/zsh/gits/art.png",
    "type": "kitty-direct",
    "height": 20,
    "width": 32,
    "padding": { "right": 3 }
  },
  "display": { "separator": " │ ", "color": { "keys": "blue", "separator": "blue" }, "key": { "width": 7 } },
  "modules": [
    { "type": "custom", "format": "\u001b[34m┌─[ \u001b[94mSECTION 9 // NAVI-00\u001b[34m ]" },
    { "type": "custom", "format": "\u001b[34m│" },
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PKGS", "format": "{pacman}" },
    { "type": "shell", "key": "SHELL" },
    { "type": "terminal", "key": "TERM" },
    { "type": "wm", "key": "WM" },
    { "type": "cpu", "key": "CPU", "format": "{cores-logical} threads @ {freq-max}" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK" },
    { "type": "custom", "format": "\u001b[34m└──────────────────────" }
  ]
}
