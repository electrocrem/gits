// Ghost in the Shell: one solid monochrome strip, no islands, no theme/wallpaper switchers.
{
    "layer": "top",
    "output": ["*"],
    "height": 24,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "spacing": 0,

    "modules-left": [
        "custom/gits-ws1",
        "custom/gits-ws2",
        "custom/gits-ws3",
        "custom/gits-ws4",
        "custom/gits-ws5",
        "custom/gits-ws6",
        "custom/gits-ws7",
        "custom/gits-ws8",
        "custom/gits-ws9",
        "custom/gits-ws10",
        "hyprland/window#gits"
    ],
    "modules-center": [
        "clock#gits",
        "custom/gits-player"
    ],
    "modules-right": [
        "custom/gits-updates",
        "idle_inhibitor#gits",
        "custom/gits-focus",
        "custom/gits-rec",
        "custom/gits-sys",
        "custom/gits-gpu",
        "memory#gits",
        "disk#gits",
        "network#gits",
        "bluetooth#gits",
        "pulseaudio#gits",
        "custom/gits-lang",
        "custom/gits-mode",
        "custom/gits-notify",
        "battery#gits",
        "tray",
        "custom/gits-power"
    ],

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    // workspace buttons 1-10 (scripts/gits-ws.sh): each bar shows only its own monitor's workspaces; click = go there, scroll = next/prev.
    // Not waybar's hyprland/workspaces: its clicks send a dispatch that a Lua Hyprland config rejects.
    "custom/gits-ws1": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 1", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws2": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 2", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws3": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 3", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws4": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 4", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws5": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 5", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws6": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 6", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws7": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 7", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"7\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws8": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 8", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"8\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws9": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 9", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"9\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },
    "custom/gits-ws10": { "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-ws.sh 10", "return-type": "json", "restart-interval": 2, "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"10\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'" },

    "hyprland/window#gits": {
        "format": " {title}",
        "max-length": 24,
        "separate-outputs": true,
        "rewrite": { "^$": " SECTION 9" }
    },

    "clock#gits": {
        "interval": 1,
        "format": "{:%H:%M:%S  //  %Y.%m.%d}",
        "format-alt": "{:%A  //  %d %B %Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "<b>{}</b>",
                "today": "<u><b>{}</b></u>"
            }
        }
    },

    "custom/gits-player": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-player.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "on-click": "gits-panel media",
        "on-click-middle": "gits-media play-pause",
        "on-click-right": "gits-media next",
        "on-scroll-up": "gits-media previous",
        "on-scroll-down": "gits-media next"
    },

    // CPU usage + package temperature (k10temp); tooltip: model, freq, load, GPU temp, fans
    "custom/gits-cpu": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-cpu.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "on-click": "gits-sysmon"
    },

    // CPU + temperature in the text, GPU / RAM / fans / swap in the tooltip (scripts/gits-sys.sh); was three modules
    "custom/gits-sys": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-sys.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": true,
        "on-click": "gits-sysmon"
    },

    // GPU temperature: iGPU always, dGPU only while it is awake (see scripts/gits-gpu.sh)
    "custom/gits-gpu": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-gpu.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": true,
        "on-click": "gits-sysmon"
    },

    // pending updates, hidden when there are none (scripts/gits-updates.sh); checked every 30 min
    "custom/gits-updates": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-updates.sh",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true,
        "on-click": "gits-update",
        "on-click-right": "pkill -RTMIN+9 -x waybar",
        "signal": 9
    },

    // caffeine: while on, hypridle neither dims, locks, turns the screen off nor suspends
    "idle_inhibitor#gits": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "CAFFEINE ON: no dim / lock / sleep",
        "tooltip-format-deactivated": "caffeine off: idle timers work (click to keep awake)"
    },

    "disk#gits": {
        "interval": 60,
        "path": "/",
        "states": { "warning": 85, "critical": 95 },
        "format": "󰋊 {percentage_used}%",
        "tooltip-format": "DISK  {path}\n{used} / {total}  ({percentage_used}%)\nFREE  {free}",
        "on-click": "gits-open explorer"
    },

    "memory#gits": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "RAM   {used:0.1f} / {total:0.1f} GiB  ({percentage}%)\nAVAIL {avail:0.1f} GiB\nSWAP  {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "on-click": "gits-sysmon"
    },

    "network#gits": {
        "min-length": 3,
        "align": 0.5,
        "interval": 5,
        "format-wifi": "",
        "format-ethernet": "󰈂",
        "format-disconnected": "󰦩",
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\nIP    {ipaddr}/{cidr}\nGW    {gwaddr}\nBAND  {frequency} GHz\nDOWN  {bandwidthDownBytes}\nUP    {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nIP    {ipaddr}/{cidr}\nGW    {gwaddr}\nDOWN  {bandwidthDownBytes}\nUP    {bandwidthUpBytes}",
        "tooltip-format-disconnected": "no network link",
        "on-click": "gits-wifi",
        "on-click-right": "nm-connection-editor"
    },

    // Bluetooth: dim when off, bright with a device count when connected
    "bluetooth#gits": {
        "format": "",
        "format-on": "",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "format-connected-battery": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}  [{status}]\n{controller_address}",
        "tooltip-format-connected": "{controller_alias}  [{status}]\n{num_connections} connected\n──────────────────────\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
        "on-click": "gits-bt",
        "on-click-middle": "blueman-manager",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },

    "pulseaudio#gits": {
        "min-length": 3,
        "align": 0.5,
        "format": "{icon}",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "scroll-step": 5,
        "tooltip-format": "{desc}\nVOLUME {volume}%\nscroll: volume · middle: mute · right: mixer",
        "on-click": "gits-panel mixer",
        "on-click-right": "pavucontrol-qt -t 3 || pavucontrol -t 3",
        "on-click-middle": "gits-vol mute"
    },

    // Focus timer (gits-focus): hidden while idle; shows the time left of the work / break phase; click opens its menu
    "custom/gits-focus": {
        "exec": "gits-focus bar",
        "return-type": "json",
        "interval": 1,
        "tooltip": true,
        "on-click": "gits-focus menu"
    },

    // Screen recording indicator: empty (= hidden) unless gits-rec is recording; click stops it
    "custom/gits-rec": {
        "exec": "gits-rec bar",
        "return-type": "json",
        "interval": 1,
        "tooltip": true,
        "on-click": "gits-rec stop"
    },

    // Current keyboard layout (event-driven, see scripts/gits-lang.sh); caps lock toggles it, click too
    "custom/gits-lang": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-lang.sh",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": true,
        "on-click": "hyprctl switchxkblayout all next"
    },

    // Workflow (operating mode) switcher: click = next, scroll = next/prev, right = menu.
    // Refreshed by signal 8 (sent by scripts/gits-mode.sh) plus a slow poll for changes made elsewhere (keybinds).
    "custom/gits-mode": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-mode.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "tooltip": true,
        "on-click": "$XDG_CONFIG_HOME/waybar/scripts/gits-mode.sh next",
        "on-click-right": "gits-workflow select",
        "on-scroll-up": "$XDG_CONFIG_HOME/waybar/scripts/gits-mode.sh prev",
        "on-scroll-down": "$XDG_CONFIG_HOME/waybar/scripts/gits-mode.sh next"
    },

    "custom/gits-notify": {
        "exec": "$XDG_CONFIG_HOME/waybar/scripts/gits-notify.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": true,
        "on-click": "gits-panel notify",
        "on-click-right": "dunstctl set-paused toggle",
        "on-click-middle": "dunstctl history-clear"
    },

    "battery#gits": {
        "interval": 10,
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\nPOWER  {power:0.1f} W\nHEALTH {health}%\nCYCLES {cycles}"
    },

    "custom/gits-power": {
        "format": "",
        "tooltip-format": "control panel · power\nright: logout menu · Super+I: all settings",
        "on-click": "gits-panel control",
        "on-click-right": "gits-logout"
    }
}
