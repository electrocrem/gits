{
    "label": "lock",
    "action": "loginctl lock-session",
    "text": "󰌾  LOCK",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "gits-exit",
    "text": "󰍃  LOGOUT",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "loginctl lock-session && sleep 0.5 && systemctl suspend",
    "text": "󰤄  SLEEP",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "󰐥  SHUTDOWN",
    "keybind": "s"
}

{
    "label": "hibernate",
    "action": "systemctl hibernate",
    "text": "󰋊  HIBERNATE",
    "keybind": "h"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "󰜉  REBOOT",
    "keybind": "r"
}
