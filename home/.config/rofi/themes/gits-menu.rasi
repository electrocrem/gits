/**
 * ROFI Layout
 *
 * Generic Ghost in the Shell list menu (gits-menu: Wi-Fi, Bluetooth, power profile). Same HUD look as notification.rasi
 * plus a "// " filter line. Title and tag come from `-theme-str` (see ~/.local/bin/gits-menu).
 */

configuration {
    modi:                        "dmenu";
    show-icons:                  false;
    font:                        "JetBrainsMono Nerd Font 10";
}

@theme "~/.config/rofi/theme.rasi"

window {
    enabled:                     true;
    fullscreen:                  false;
    width:                       34em;
    transparency:                "real";
    cursor:                      "default";
    padding:                     0em;
    border:                      1px;
    border-radius:               0em;
    border-color:                @main-br;
    background-color:            @main-bg;
}
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0em;
    orientation:                 vertical;
    children:                    [ "hud" , "inputbar" , "listview" ];
    background-color:            transparent;
}

// Header //
hud {
    expand:                      false;
    orientation:                 horizontal;
    padding:                     0.9em 1.2em;
    border:                      0px 0px 1px 0px;
    border-color:                @separatorcolor;
    background-color:            @main-ex;
    children:                    [ "textbox-title" , "textbox-tag" ];
}
textbox-title {
    expand:                      true;
    content:                     "MENU";
    font:                        "JetBrainsMono Nerd Font Bold 10";
    vertical-align:              0.5;
    background-color:            transparent;
    text-color:                  @main-fg;
}
textbox-tag {
    expand:                      false;
    content:                     "// メニュー";
    vertical-align:              0.5;
    background-color:            transparent;
    text-color:                  #596977;
}

// Filter //
inputbar {
    enabled:                     true;
    expand:                      false;
    spacing:                     0.6em;
    padding:                     0.6em 1.2em;
    border:                      0px 0px 1px 0px;
    border-color:                @separatorcolor;
    background-color:            transparent;
    children:                    [ "prompt" , "entry" ];
}
prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  #596977;
}
entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      text;
    placeholder:                 "filter_";
    placeholder-color:           #596977;
}

// List //
listview {
    enabled:                     true;
    expand:                      false;
    spacing:                     0em;
    padding:                     0.4em 0em;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                false;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
}
element {
    enabled:                     true;
    spacing:                     1em;
    padding:                     0.6em 1.2em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @main-fg;
    border-radius:               0em;
}
element normal.normal, element alternate.normal, element selected.normal {
    border-radius:               0em;
}
element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}
element-icon {
    enabled:                     false;
}
element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   none;
}

error-message {
    text-color:                  @main-fg;
    background-color:            @main-bg;
    padding:                     1em;
}
