[Unit]
Description=waybar (the GitS bar; systemd restarts it after a crash)
PartOf=gits-session.target

[Service]
ExecStart=/usr/bin/waybar -c %h/.config/waybar/layouts/ghost-in-the-shell.jsonc -s %h/.config/waybar/styles/ghost-in-the-shell.css
Restart=on-failure
RestartSec=1

[Install]
WantedBy=gits-session.target
