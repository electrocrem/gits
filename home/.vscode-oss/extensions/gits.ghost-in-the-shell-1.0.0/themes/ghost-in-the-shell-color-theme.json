  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#596977", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#6EE7B7" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#FF7A5C" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#F5DC7E" } },
    { "scope": ["constant.other", "variable.other.constant"], "settings": { "foreground": "#E8C547" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#2ED3D7" } },
    { "scope": ["keyword.control", "keyword.control.flow"], "settings": { "foreground": "#E5432B" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#9FC5D6" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#459BF1" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#5EF1F5" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"], "settings": { "foreground": "#C8F4FF" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#A99CF5", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#E5432B", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#9FC5D6" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#2ED3D7" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#A99CF5", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name", "support.type.property-name.json"], "settings": { "foreground": "#459BF1" } },
    { "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#5EF1F5" } },
    { "scope": ["support.constant.property-value.css", "support.constant.color"], "settings": { "foreground": "#F5DC7E" } },
    { "scope": ["entity.name.function.decorator", "meta.decorator", "meta.annotation", "punctuation.decorator"], "settings": { "foreground": "#A99CF5" } },
    { "scope": ["entity.name.import", "meta.import", "support.module"], "settings": { "foreground": "#9FC5D6" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#2ED3D7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#DDF9FF", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#DDF9FF", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#6EE7B7" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#5EF1F5" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#596977", "fontStyle": "italic" } },
    { "scope": ["markup.list punctuation.definition.list"], "settings": { "foreground": "#E5432B" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#34D399" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#E5432B" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#459BF1" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E5432B" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#E8C547", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#A99CF5", "italic": true },
    "property": "#9FC5D6",
    "function": "#459BF1",
    "method": "#459BF1",
    "class": "#5EF1F5",
    "interface": "#5EF1F5",
    "enum": "#5EF1F5",
    "type": "#5EF1F5",
    "namespace": "#5EF1F5",
    "enumMember": "#F5DC7E",
    "macro": "#A99CF5",
    "variable.readonly": "#E8C547",
    "selfParameter": { "foreground": "#E5432B", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}
